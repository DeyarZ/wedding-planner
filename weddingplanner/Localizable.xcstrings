    "One category is on us — every expense you add is filed there. Premium opens all of them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فئة واحدة على حسابنا — كل مصروف تضيفه يُدرج فيها. والنسخة المميزة تفتحها كلها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednu kategorii máte od nás — každý výdaj, který přidáte, jde do ní. Premium odemkne všechny."
          }
        },
        "da" : {
