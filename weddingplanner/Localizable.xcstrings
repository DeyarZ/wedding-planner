    "If you have any questions about this Privacy Policy, please contact us. We reserve the right to update this policy at any time, and we will notify you of any material changes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Fragen zu dieser Datenschutzerklärung kontaktiere uns. Wir können diese Erklärung jederzeit aktualisieren und informieren dich über wesentliche Änderungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes preguntas sobre esta política, contáctanos. Podemos actualizarla en cualquier momento y te avisaremos de cambios importantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour toute question sur cette politique, contactez-nous. Nous pouvons la mettre à jour à tout moment et vous informerons des changements importants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per domande su questa informativa, contattaci. Possiamo aggiornarla in qualsiasi momento e ti avviseremo di modifiche rilevanti."
          }
        }
      }
    },
