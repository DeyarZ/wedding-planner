    "We're a small team trying to grow and help more couples plan their perfect day.\n\nWould you mind leaving us a quick review?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نحن فريق صغير يسعى للنمو ولمساعدة المزيد من المقبلين على الزواج في التخطيط ليومهم المثالي.\n\nهل تمانع في ترك تقييم سريع لنا؟"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jsme malý tým, který se snaží růst a pomáhat víc párům naplánovat jejich dokonalý den.\n\nNenapsali byste nám krátkou recenzi?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi er et lille team, der prøver at vokse og hjælpe flere par med at planlægge deres perfekte dag.\n\nVil du give os en hurtig anmeldelse?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir sind ein kleines Team und möchten mehr Paaren bei ihrem perfekten Tag helfen.\n\nWürdest du uns kurz bewerten?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somos un equipo pequeño que quiere ayudar a más parejas con su día perfecto.\n\n¿Nos dejas una reseña rápida?"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oleme väike tiim, kes püüab kasvada ja aidata üha rohkematel paaridel oma täiuslikku päeva planeerida.\n\nKas jätaksid meile lühikese arvustuse?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olemme pieni tiimi, joka haluaa kasvaa ja auttaa yhä useampaa paria suunnittelemaan täydellisen päivänsä.\n\nJättäisitkö meille lyhyen arvion?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous sommes une petite équipe qui veut aider plus de couples à réussir leur grand jour.\n\nLaisseriez-vous un avis rapide ?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mali smo tim koji želi rasti i pomoći još parova da isplaniraju svoj savršeni dan.\n\nBiste li nam ostavili kratku recenziju?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kis csapat vagyunk, és szeretnénk növekedni, hogy még több pár tervezhesse meg a tökéletes napját.\n\nÍrnál nekünk egy gyors értékelést?"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Við erum lítið teymi sem langar að vaxa og hjálpa fleiri pörum að skipuleggja fullkomna daginn sinn.\n\nMyndirðu vilja skilja eftir stutta umsögn?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siamo un piccolo team che vuole aiutare più coppie nel loro giorno perfetto.\n\nCi lasci una breve recensione?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私たちは、もっと多くのカップルの理想の一日をお手伝いしたいと願う小さなチームです。\n\nよろしければ、短いレビューをいただけませんか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저희는 더 많은 예비부부의 완벽한 하루를 돕고 싶은 작은 팀이에요.\n\n짧은 리뷰를 남겨주실 수 있을까요?"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mēs esam maza komanda, kas cenšas augt un palīdzēt arvien vairāk pāriem izplānot savu ideālo dienu.\n\nVai atstātu mums īsu atsauksmi?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi er et lite team som prøver å vokse og hjelpe flere par med å planlegge den perfekte dagen.\n\nHar du lyst til å gi oss en kjapp anmeldelse?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We zijn een klein team dat wil groeien en meer stellen wil helpen hun perfecte dag te plannen.\n\nZou je een korte review willen achterlaten?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteśmy małym zespołem, który chce się rozwijać i pomóc kolejnym parom zaplanować ich idealny dzień.\n\nZostawicie nam krótką opinię?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somos uma equipe pequena tentando crescer e ajudar mais casais a organizar o dia perfeito.\n\nVocê poderia deixar uma avaliação rápida?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suntem o echipă mică și încercăm să creștem, ca să ajutăm mai multe cupluri să-și planifice ziua perfectă.\n\nNe-ai lăsa o recenzie scurtă?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы небольшая команда и хотим помочь как можно большему числу пар спланировать их идеальный день.\n\nОставите короткий отзыв?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sme malý tím, ktorý chce rásť a pomôcť ďalším párom naplánovať ich dokonalý deň.\n\nNechali by ste nám krátku recenziu?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smo majhna ekipa, ki želi rasti in pomagati še več parom pri načrtovanju popolnega dne.\n\nBi nam pustila kratko oceno?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi är ett litet team som försöker växa och hjälpa fler par att planera sin perfekta dag.\n\nSkulle du vilja lämna ett snabbt omdöme?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราเป็นทีมเล็ก ๆ ที่กำลังเติบโตและอยากช่วยคู่รักอีกหลายคู่ให้วางแผนวันที่สมบูรณ์แบบได้\n\nรบกวนช่วยรีวิวสั้น ๆ ให้เราหน่อยได้ไหม?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Büyümeye ve daha çok çiftin mükemmel gününü planlamasına yardım etmeye çalışan küçük bir ekibiz.\n\nBize kısa bir değerlendirme bırakır mısınız?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми — невелика команда, яка прагне зростати й допомагати більшій кількості пар планувати їхній ідеальний день.\n\nЗалишите нам короткий відгук?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi là một đội ngũ nhỏ đang cố gắng lớn lên và giúp nhiều cặp đôi hơn lên kế hoạch cho ngày hoàn hảo của họ.\n\nBạn có thể để lại một đánh giá ngắn giúp chúng tôi không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们是一个小团队，希望成长起来，帮助更多新人筹备完美的一天。\n\n方便给我们留个简短的评价吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們是個小團隊，希望能成長、幫助更多新人規劃他們完美的一天。\n\n方便花一分鐘留個評價嗎？"
          }
        }
      }
    },
