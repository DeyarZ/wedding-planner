    "Our app may contain links to third-party websites or services. We are not responsible for the privacy practices of these third parties. We encourage you to read their privacy policies.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsere App kann Links zu Drittanbietern enthalten. Für deren Datenschutz sind wir nicht verantwortlich. Bitte lies deren Datenschutzerklärungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuestra app puede tener enlaces a terceros. No somos responsables de su privacidad. Te recomendamos leer sus políticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notre app peut contenir des liens vers des tiers. Nous ne sommes pas responsables de leur confidentialité. Lisez leurs politiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nostra app può contenere link a terze parti. Non siamo responsabili della loro privacy. Ti invitiamo a leggere le loro informative."
          }
        }
      }
    },
