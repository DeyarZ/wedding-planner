    "Guests, plus-ones and RSVPs live in one list that stays in sync — no more three versions of the same spreadsheet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gäste, Begleitungen und Zusagen stehen in einer Liste, die immer aktuell bleibt — Schluss mit drei Versionen derselben Tabelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitados, acompañantes y RSVP viven en una sola lista siempre sincronizada: se acabaron las tres versiones de la misma hoja de cálculo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invités, accompagnants et RSVP vivent dans une seule liste toujours à jour — fini les trois versions du même tableur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitati, accompagnatori e RSVP stanno in un'unica lista sempre sincronizzata: niente più tre versioni dello stesso foglio di calcolo."
          }
        }
      }
    },
