        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taktu myndir með — það er auðveldara að sýna blóm en að lýsa þeim"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portate delle foto: i fiori è più facile mostrarli che descriverli"
