          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besplatni plan omogućuje da označite prvih 5 zadataka. Premium otključava cijeli popis zadataka, pa ništa ne ostaje zaboravljeno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ingyenes csomagban az első 5 feladatot pipálhatod ki. A Prémium feloldja az egész teendőlistát, így semmi nem marad el."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ókeypis útgáfan leyfir þér að haka við fyrstu 5 verkefnin. Premium opnar allan gátlistann, svo ekkert verði út undan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il piano gratuito ti fa spuntare le prime 5 attività. Premium sblocca l'intera checklist, così non resta indietro nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料プランでチェックできるのは最初の5つのタスクまでです。プレミアムならチェックリスト全体が使えるので、やり残しがありません。"
