        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะมีการเรียกเก็บเงินก็ต่อเมื่อถึงตอนนั้น — และคุณยกเลิกก่อนหน้านั้นเมื่อไรก็ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
