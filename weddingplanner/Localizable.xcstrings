    "Seating, plus-ones and dietary notes stay documented, so the awkward conversations happen once." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى توزيع الجلوس والمرافقون والملاحظات الغذائية موثقًا، فتحدث المحادثات المحرجة مرة واحدة فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasedací pořádek, doprovody i poznámky k jídlu zůstávají zapsané, takže nepříjemné hovory proběhnou jen jednou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bordplan, ledsagere og kostnoter bliver dokumenteret, så de akavede samtaler kun sker én gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzplan, Begleitungen und Essenswünsche sind festgehalten — die unangenehmen Gespräche führt ihr nur einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plano de mesas, los acompañantes y las notas de dieta quedan documentados, así las conversaciones incómodas solo pasan una vez."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istumisplaan, kaaslased ja toitumismärkused jäävad kirja, nii et ebamugavad vestlused tuleb pidada ainult korra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pöytäjärjestys, avecit ja ruokavaliot pysyvät kirjattuina, joten kiusalliset keskustelut käydään vain kerran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan de table, accompagnants et régimes alimentaires restent documentés : les conversations gênantes n'ont lieu qu'une fois."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raspored sjedenja, pratnje i prehrambene napomene ostaju zabilježeni, pa se neugodni razgovori vode samo jednom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ültetési rend, a kísérők és az étkezési igények dokumentálva maradnak, így a kínos beszélgetéseket csak egyszer kell lefolytatni."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borðaskipan, fylgdargestir og athugasemdir um mataræði eru skjalfest, svo vandræðalegu samtölin fara bara fram einu sinni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disposizione dei tavoli, accompagnatori e note alimentari restano scritti, così le conversazioni imbarazzanti si fanno una volta sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "席次も同伴者も食事のメモも記録に残るので、気まずい話し合いは一度きりで済みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좌석 배치, 동반자, 식사 요청 사항이 기록으로 남아, 껄끄러운 대화는 한 번이면 끝나요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sēdvietas, pavadoņi un uztura piezīmes paliek pierakstītas, tāpēc neērtās sarunas notiek tikai vienreiz."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bordplassering, følge og kostbehov holdes dokumentert, så de kleine samtalene tas bare én gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tafelindeling, introducés en dieetwensen blijven vastgelegd, zodat je die ongemakkelijke gesprekken maar één keer hoeft te voeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan stołów, osoby towarzyszące i preferencje żywieniowe są zapisane, więc niezręczne rozmowy odbywają się tylko raz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesas, acompanhantes e restrições alimentares ficam documentados, então as conversas constrangedoras acontecem só uma vez."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Așezarea la mese, însoțitorii și preferințele alimentare rămân documentate, așa că discuțiile incomode au loc o singură dată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рассадка, сопровождающие и пожелания по еде записаны, поэтому неловкие разговоры случаются только один раз."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasadací poriadok, sprievod aj stravovacie poznámky zostanú zapísané, takže nepríjemné rozhovory prebehnú len raz."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedežni red, spremljevalci in prehranske opombe ostanejo zabeleženi, tako da so neprijetni pogovori opravljeni samo enkrat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bordsplacering, medföljande och matpreferenser finns dokumenterade, så de jobbiga samtalen behöver bara tas en gång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผังที่นั่ง ผู้ติดตาม และโน้ตเรื่องอาหาร ถูกบันทึกไว้ บทสนทนาที่กระอักกระอ่วนจึงเกิดขึ้นแค่ครั้งเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturma düzeni, refakatçiler ve beslenme notları kayıtlı kalır; o zor konuşmalar bir kez yapılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
