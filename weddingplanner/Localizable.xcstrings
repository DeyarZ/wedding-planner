    "Premium breaks down RSVPs, meals and groups at a glance." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النسخة المميزة تعرض تأكيدات الحضور والوجبات والمجموعات بنظرة واحدة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium vám na jeden pohled rozebere RSVP, jídla i skupiny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium giver jer overblik over RSVP'er, menuvalg og grupper på et øjeblik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium zeigt Zusagen, Menüwünsche und Gruppen auf einen Blick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium desglosa confirmaciones, menús y grupos de un vistazo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium näitab RSVP-sid, menüüvalikuid ja rühmi ühe pilguga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium erittelee RSVP-vastaukset, ateriat ja ryhmät yhdellä silmäyksellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium détaille réponses, menus et groupes en un coup d'œil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium na prvi pogled razlaže RSVP-ove, obroke i grupe."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Prémium egy pillantás alatt lebontja a visszajelzéseket, az ételválasztásokat és a csoportokat."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium sundurliðar RSVP, matarval og hópa í einni yfirsýn."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium mostra conferme, menù e gruppi a colpo d'occhio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレミアムなら、出欠・お食事・グループをひと目で把握できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프리미엄에서는 참석 여부, 식사, 그룹을 한눈에 볼 수 있어요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium vienā mirklī parāda RSVP atbildes, ēdienus un grupas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium gir deg RSVP, menyvalg og grupper i én oversikt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met Premium zie je RSVP's, maaltijden en groepen in één oogopslag uitgesplitst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium pokazuje RSVP, dania i grupy w jednym rzucie oka."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Premium mostra RSVPs, menus e grupos detalhados de relance."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
