        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver einasti kostnaður lendir í einum af 12 flokkum, svo þú veist alltaf hvað er eftir áður en þú skuldbindur þig."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
