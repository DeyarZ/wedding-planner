    "Every deadline in your plan is counted backwards from %@ — so you always know what needs to happen this week." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل موعد نهائي في خطتك محسوب بالعد التنازلي من %@ — لتعرف دائمًا ما ينبغي إنجازه هذا الأسبوع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý termín ve vašem plánu se počítá zpětně od %@ — takže vždycky víte, co je potřeba stihnout tento týden."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle deadlines i jeres plan er regnet baglæns fra %@ — så I altid ved, hvad der skal ske i denne uge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Frist in eurem Plan wird ab %@ rückwärts gerechnet — so wisst ihr immer, was diese Woche dran ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada fecha límite de vuestro plan se cuenta hacia atrás desde %@, así siempre sabéis qué toca esta semana."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga tähtaeg sinu plaanis on arvestatud tagurpidi kuupäevast %@ — nii tead alati, mis peab sel nädalal ära tehtud saama."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen suunnitelmasi määräaika lasketaan taaksepäin päivästä %@ — niin tiedät aina, mitä tällä viikolla pitää tehdä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque échéance de votre plan est calculée à rebours à partir du %@ — vous savez toujours ce qui doit avancer cette semaine."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki se rok u vašem planu računa unatrag od %@ — pa uvijek znate što je na redu ovaj tjedan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A terved minden határideje ettől a naptól visszafelé számolódik: %@ — így mindig tudod, minek kell megtörténnie ezen a héten."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allir frestir í áætluninni eru reiknaðir aftur á bak frá %@ — svo þú veist alltaf hvað þarf að gerast í þessari viku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: ogni scadenza del vostro piano è calcolata a ritroso da qui, così sapete sempre cosa deve succedere questa settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プランのすべての期限は %@ から逆算されています — だから今週やるべきことが常にわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플랜의 모든 마감일은 %@을(를) 기준으로 거꾸로 계산돼요 — 그래서 이번 주에 할 일이 늘 분명해요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katrs termiņš tavā plānā ir atskaitīts atpakaļ no %@ — tāpēc vienmēr zini, kas jāpaveic šonedēļ."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver frist i planen regnes bakover fra %@ – så dere alltid vet hva som må skje denne uken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke deadline in jullie plan is teruggerekend vanaf %@ — zo weet je altijd wat er deze week moet gebeuren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy termin w Waszym planie liczymy wstecz od %@ — dzięki temu zawsze wiecie, co musi się wydarzyć w tym tygodniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os prazos do seu plano são contados de trás para frente a partir de %@ — assim vocês sempre sabem o que precisa acontecer esta semana."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare termen din planul vostru este calculat înapoi de la %@ — așa că știți mereu ce trebuie făcut săptămâna aceasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
