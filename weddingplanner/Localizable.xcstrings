            "state" : "translated",
            "value" : "Juhlapaikka, kaupunki tai pelkkä idea — mikä tahansa käy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lieu de réception, une ville ou une simple idée — ce que vous avez."
          }
