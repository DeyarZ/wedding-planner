          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fidati dei tuoi fornitori,\nanche loro vogliono un giorno bellissimo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "業者を信じてください\n彼らもおふたりの一日を美しくしたいと願っています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업체를 믿어요,\n그들도 두 분의 하루가 아름답기를 바라요"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzticies saviem pakalpojumu sniedzējiem —\narī viņi vēlas, lai tava diena būtu skaista"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stol på leverandørene deres,\nde vil også at dagen deres skal bli vakker"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertrouw je leveranciers,\nzij willen ook dat jullie dag prachtig wordt"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaufajcie swoim usługodawcom,\nim też zależy, żeby Wasz dzień był piękny"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
