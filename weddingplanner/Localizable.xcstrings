    "Halfway there! Time to finalize those big decisions" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قطعتِ نصف الطريق! حان وقت حسم القرارات الكبيرة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jste v polovině! Je čas dotáhnout ta velká rozhodnutí"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halvvejs! Nu skal de store beslutninger på plads"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halbzeit! Zeit, die großen Entscheidungen zu treffen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Ya estás a mitad de camino! Es hora de cerrar las grandes decisiones"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pool teed käidud! Aeg suured otsused paika panna"
