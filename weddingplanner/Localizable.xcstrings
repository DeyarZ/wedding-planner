          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tikai tad tiek veikts maksājums — un līdz tam jebkurā brīdī vari atcelt."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Først da blir noe belastet – og du kan si opp når som helst før det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas dan wordt er iets afgeschreven — en je kunt daarvoor altijd nog opzeggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopiero wtedy pobierzemy opłatę — a do tego czasu możecie anulować w każdej chwili."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só então algo é cobrado — e você pode cancelar antes disso quando quiser."
