    "Getting you, the party and the guests between locations" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنقّلك أنت والحفل والضيوف بين المواقع"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostat vás, svatebčany i hosty mezi místy"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transport af jer, selskabet og gæsterne mellem lokationerne"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euch, die Hochzeitsgesellschaft und die Gäste von Ort zu Ort bringen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llevaros a vosotros, al cortejo y a los invitados de un sitio a otro"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viib sinu, seltskonna ja külalised ühest kohast teise"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teidät, hääseurue ja vieraat paikasta toiseen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous, le cortège et les invités d'un lieu à l'autre"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da vi, svatovi i gosti stignete s lokacije na lokaciju"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hogy te, a társaság és a vendégek eljussatok a helyszínek között"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Að koma ykkur, veislunni og gestunum milli staða"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come spostare voi, il corteo e gli invitati tra un luogo e l'altro"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おふたりも、参列者も、ゲストも、会場から会場へ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 분과 일행, 하객들의 장소 이동까지"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kā tu, svinību dalībnieki un viesi nokļūs no vienas vietas uz otru"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å få dere, følget og gjestene mellom stedene"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jullie, het gezelschap en de gasten van locatie naar locatie brengen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przewiezienie Was, orszaku i gości między miejscami"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levar vocês, o cortejo e os convidados de um lugar para o outro"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vă duce pe voi, alaiul și invitații dintr-o locație în alta"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как вы, ваша команда и гости будете добираться между локациями"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako sa vy, svadobčania aj hostia dostanete z miesta na miesto"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevoz vaju, družbe in gostov med lokacijami"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att få dig, sällskapet och gästerna mellan platserna"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พาคุณ ทีมงาน และแขก เดินทางระหว่างสถานที่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sizi, ekibi ve misafirleri mekânlar arasında taşımak"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дістатися між локаціями — вам, весільній компанії та гостям"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đưa bạn, dàn phù dâu phù rể và khách mời di chuyển giữa các địa điểm"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接送你们、伴郎伴娘和宾客往返各个地点"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓你們、伴郎伴娘和賓客順利在各地點間移動"
          }
        }
      }
    },
