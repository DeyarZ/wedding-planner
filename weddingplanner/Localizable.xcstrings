    "The free plan lets you tick off your first 5 tasks. Premium unlocks the whole checklist, so nothing gets left behind." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخطة المجانية تتيح لك إنجاز أول 5 مهام. أما النسخة المميزة فتفتح قائمة المهام كاملة، فلا يُترك شيء خلفك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V plánu zdarma odškrtnete prvních 5 úkolů. Premium odemkne celý seznam, takže nic nezůstane stranou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den gratis plan lader jer hakke de første 5 opgaver af. Premium låser hele tjeklisten op, så intet bliver glemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im kostenlosen Plan hakst du die ersten 5 Aufgaben ab. Premium schaltet die komplette Checkliste frei – damit nichts liegen bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plan gratuito te deja marcar las primeras 5 tareas. Premium desbloquea la lista entera para que no se quede nada."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasuta plaan laseb sul ära märkida esimesed 5 ülesannet. Premium avab kogu kontrollnimekirja, nii et miski ei jää tegemata."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmaisessa versiossa voit kuitata viisi ensimmäistä tehtävää. Premium avaa koko tehtävälistan, jottei mikään jää tekemättä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
