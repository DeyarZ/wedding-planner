        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ozveme sa vám skôr, než bude niečo splatné — a raz pred koncom akejkoľvek skúšobnej verzie. %lld dní nie je tak veľa, ako to znie."
