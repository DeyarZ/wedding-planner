    "Paul Taylor" : {},
    "Pay once, yours until the big day & beyond" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادفع مرة واحدة، وتبقى لك حتى اليوم الكبير وما بعده"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaplaťte jednou, je vaše do velkého dne i po něm"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betal én gang — jeres frem til den store dag & længe efter"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal zahlen – bis zum großen Tag und darüber hinaus"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga una vez, tuyo hasta el gran día y más allá"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksa korra — sinu oma kuni suure päevani ja kaugemalegi"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksa kerran — sinun suureen päivään ja sen jälkeenkin"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payez une fois, à vous jusqu’au grand jour et au-delà"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platite jednom, vaše do velikog dana i nakon njega"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fizess egyszer, és a tiéd a nagy napig és azon túl is"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borgaðu einu sinni, þitt fram að stóra deginum og áfram"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paghi una volta, tuo fino al grande giorno e oltre"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度のお支払いで、大切な日もその先もずっと"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 결제하면 결혼식 당일과 그 이후까지"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samaksā vienreiz — tavs līdz lielajai dienai un pēc tās"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betal én gang – ditt frem til den store dagen og etterpå"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén keer betalen, van jullie tot en na de grote dag"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapłaćcie raz — Wasze do wielkiego dnia i dłużej"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pague uma vez, seu até o grande dia e depois dele"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plătești o dată, e al tău până la ziua cea mare și după"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заплатите один раз — приложение ваше до свадьбы и после"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaplaťte raz a je vaše až do veľkého dňa a ešte ďalej"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plačata enkrat, ostane vajino do velikega dne in še dlje"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betala en gång, din fram till stora dagen och därefter"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จ่ายครั้งเดียว เป็นของคุณจนถึงวันสำคัญและหลังจากนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kez ödeyin; büyük güne kadar ve sonrasında da sizin"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заплатіть один раз — і він ваш до великого дня й після нього"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trả một lần, của bạn đến ngày trọng đại và mãi về sau"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次付费，直到大喜之日以及之后都属于你们"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次付款，從大喜之日到之後都是你的"
          }
        }
      }
    },
