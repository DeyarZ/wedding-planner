        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sơ đồ chỗ ngồi, người đi cùng và ghi chú ăn uống đều được lưu lại, nên những cuộc trò chuyện khó xử chỉ phải diễn ra một lần."
          }
        },
