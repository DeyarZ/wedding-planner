    "Perfect is not the goal,\njoy is" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المثالية ليست الهدف،\nبل الفرح"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cílem není dokonalost,\nale radost"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfekt er ikke målet,\nglæde er"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfekt ist nicht das Ziel,\nFreude ist es"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo perfecto no es la meta,\nla alegría sí"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eesmärk pole täiuslikkus,\nvaid rõõm"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täydellisyys ei ole päämäärä,\nilo on"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La perfection n'est pas le but,\nla joie l'est"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Savršenstvo nije cilj,\nradost jest"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem a tökéletesség a cél,\nhanem az öröm"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fullkomnun er ekki markmiðið,\ngleðin er það"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La perfezione non è l'obiettivo,\nlo è la gioia"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完璧が目的ではありません\n大切なのは、楽しむこと"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완벽함이 아니라,\n행복이 목표예요"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
