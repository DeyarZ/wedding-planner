          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek se tada nešto naplaćuje — a do tada možete otkazati u bilo kojem trenutku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak ezután történik bármilyen terhelés — és addig bármikor lemondhatod."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
