          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobro jutro! Vsak korak te približa besedici 'da' 💍"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "God morgon! Varje steg för er närmare ert ja 💍"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อรุณสวัสดิ์! ทุกก้าวพาคุณเข้าใกล้วันที่จะพูดว่า 'ฉันยินดี' มากขึ้น 💍"
