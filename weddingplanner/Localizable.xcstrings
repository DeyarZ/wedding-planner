    "By downloading, installing, or using the Wedding Planner app, you agree to be bound by these Terms of Use. If you do not agree to these terms, please do not use our app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بتنزيل تطبيق Wedding Planner أو تثبيته أو استخدامه، فإنك توافق على الالتزام بشروط الاستخدام هذه. وإذا كنت لا توافق على هذه الشروط، فيُرجى عدم استخدام تطبيقنا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stažením, instalací nebo používáním aplikace Wedding Planner souhlasíte s těmito Podmínkami použití. Pokud s těmito podmínkami nesouhlasíte, aplikaci prosím nepoužívejte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved at downloade, installere eller bruge appen Wedding Planner accepterer du at være bundet af disse brugsvilkår. Hvis du ikke accepterer vilkårene, bedes du undlade at bruge vores app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Herunterladen, Installieren oder Nutzen der Wedding-Planner-App stimmst du diesen Nutzungsbedingungen zu. Wenn du nicht zustimmst, nutze die App bitte nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al descargar, instalar o usar la app Wedding Planner, aceptas estos términos de uso. Si no estás de acuerdo, no uses la app."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakenduse Wedding Planner allalaadimise, paigaldamise või kasutamisega nõustud käesolevate kasutustingimustega. Kui sa nende tingimustega ei nõustu, palun ära meie rakendust kasuta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lataamalla, asentamalla tai käyttämällä Wedding Planner -sovellusta sitoudut noudattamaan näitä käyttöehtoja. Jos et hyväksy näitä ehtoja, älä käytä sovellustamme."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En téléchargeant, installant ou utilisant l'app Wedding Planner, vous acceptez ces conditions d'utilisation. Si vous n'êtes pas d'accord, n'utilisez pas l'app."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzimanjem, instaliranjem ili korištenjem aplikacije Wedding Planner pristajete na ove Uvjete korištenja. Ako se ne slažete s ovim uvjetima, molimo vas da ne koristite našu aplikaciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Wedding Planner alkalmazás letöltésével, telepítésével vagy használatával elfogadod a jelen Felhasználási feltételeket. Ha nem értesz egyet ezekkel a feltételekkel, kérjük, ne használd az alkalmazásunkat."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Með því að hlaða niður, setja upp eða nota Wedding Planner appið samþykkir þú þessa notkunarskilmála. Ef þú samþykkir ekki skilmálana skaltu ekki nota appið."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scaricando, installando o usando l'app Wedding Planner accetti questi termini d'uso. Se non sei d'accordo, non usare l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wedding Planner アプリをダウンロード、インストール、またはご利用いただくことで、お客様は本利用規約に拘束されることに同意したものとみなされます。本規約に同意されない場合は、本アプリをご利用にならないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wedding Planner 앱을 다운로드, 설치 또는 사용하시면 본 이용약관에 동의하는 것으로 간주됩니다. 약관에 동의하지 않으시는 경우 앱을 사용하지 말아 주세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lejupielādējot, instalējot vai lietojot lietotni Wedding Planner, tu piekrīti ievērot šos lietošanas noteikumus. Ja nepiekrīti šiem noteikumiem, lūdzu, nelieto mūsu lietotni."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved å laste ned, installere eller bruke Wedding Planner-appen godtar du å være bundet av disse bruksvilkårene. Hvis du ikke godtar vilkårene, ber vi deg om ikke å bruke appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door de Wedding Planner-app te downloaden, te installeren of te gebruiken, ga je akkoord met deze Gebruiksvoorwaarden. Ben je het niet eens met deze voorwaarden, gebruik onze app dan niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobierając, instalując lub korzystając z aplikacji Wedding Planner, zgadzasz się na przestrzeganie niniejszych Warunków korzystania. Jeśli nie akceptujesz tych warunków, prosimy nie korzystać z naszej aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao baixar, instalar ou usar o Wedding Planner, você concorda com estes Termos de Uso. Se não concordar com eles, por favor não use o app."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prin descărcarea, instalarea sau utilizarea aplicației Wedding Planner, ești de acord să respecți acești Termeni de utilizare. Dacă nu ești de acord cu acești termeni, te rugăm să nu folosești aplicația noastră."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачивая, устанавливая или используя приложение Wedding Planner, вы соглашаетесь соблюдать настоящие Условия использования. Если вы не согласны с ними, пожалуйста, не пользуйтесь приложением."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiahnutím, inštaláciou alebo používaním aplikácie Wedding Planner súhlasíte s tým, že ste viazaní týmito Podmienkami používania. Ak s týmito podmienkami nesúhlasíte, aplikáciu prosím nepoužívajte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S prenosom, namestitvijo ali uporabo aplikacije Wedding Planner se strinjate, da vas ti pogoji uporabe zavezujejo. Če se s temi pogoji ne strinjate, aplikacije ne uporabljajte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genom att ladda ner, installera eller använda appen Wedding Planner godkänner du att vara bunden av dessa användarvillkor. Om du inte godkänner villkoren ber vi dig att inte använda appen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดาวน์โหลด ติดตั้ง หรือใช้งานแอป Wedding Planner ถือว่าคุณยอมรับและผูกพันตามข้อกำหนดการใช้งานนี้ หากคุณไม่ยอมรับข้อกำหนดเหล่านี้ กรุณาอย่าใช้แอปของเรา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wedding Planner uygulamasını indirerek, yükleyerek veya kullanarak bu Kullanım Koşulları ile bağlı olmayı kabul edersiniz. Bu koşulları kabul etmiyorsanız lütfen uygulamamızı kullanmayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантажуючи, встановлюючи або використовуючи застосунок Wedding Planner, ви погоджуєтеся дотримуватися цих Умов використання. Якщо ви не згодні з ними, будь ласка, не користуйтеся нашим застосунком."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bằng việc tải xuống, cài đặt hoặc sử dụng ứng dụng Wedding Planner, bạn đồng ý chịu ràng buộc bởi các Điều khoản sử dụng này. Nếu bạn không đồng ý với các điều khoản này, vui lòng không sử dụng ứng dụng của chúng tôi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载、安装或使用「婚礼策划」应用，即表示您同意受本使用条款的约束。如果您不同意这些条款，请勿使用本应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載、安裝或使用 Wedding Planner 應用程式，即表示你同意受本使用條款約束。若你不同意這些條款，請勿使用本應用程式。"
          }
        }
