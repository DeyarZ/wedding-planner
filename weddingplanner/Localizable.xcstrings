    "Good morning beautiful! Ready to plan your perfect day? 💕" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صباح الخير يا جميلة! هل أنتِ مستعدة للتخطيط ليومكِ المثالي؟ 💕"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krásné dobré ráno! Připraveni naplánovat svůj dokonalý den? 💕"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godmorgen, smukke! Klar til at planlægge jeres perfekte dag? 💕"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guten Morgen, Schöne! Bereit, deinen perfekten Tag zu planen? 💕"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Buenos días, guapa! ¿Lista para planificar tu día perfecto? 💕"
