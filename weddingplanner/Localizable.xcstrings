        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na pola ste puta! Vrijeme je da donesete velike odluke"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Félúton vagy! Ideje véglegesíteni a nagy döntéseket"
