        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledování používáme jen k tomu, abychom vám plánování přizpůsobili a udrželi aplikaci zdarma. Rozhodnete se na další obrazovce."
          }
        },
        "da" : {
          "stringUnit" : {
