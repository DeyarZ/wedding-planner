    "Invitations, RSVPs, plus-ones, dietary notes and seating all hang off this one number — change it any time and everything follows." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الدعوات وتأكيدات الحضور والمرافقون والملاحظات الغذائية وتوزيع الجلوس، كلها مرتبطة بهذا الرقم — غيّره في أي وقت وسيتبعه كل شيء."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozvánky, RSVP, doprovody, poznámky k jídlu i zasedací pořádek se odvíjejí od tohoto jednoho čísla — změňte ho kdykoli a všechno se přizpůsobí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitationer, RSVP'er, ledsagere, kostnoter og bordplan hænger alle sammen på dette ene tal — ændr det når som helst, så følger resten med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einladungen, Zusagen, Begleitungen, Essenswünsche und Sitzplan hängen alle an dieser einen Zahl — ändert sie jederzeit, alles andere passt sich an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitaciones, RSVP, acompañantes, notas de dieta y plano de mesas dependen de este número: cambiadlo cuando queráis y todo lo demás se ajusta solo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutsed, RSVP-d, kaaslased, toitumismärkused ja istumisplaan sõltuvad kõik sellest ühest arvust — muuda seda millal iganes ja kõik ülejäänu järgneb."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutsut, RSVP-vastaukset, avecit, ruokavaliot ja pöytäjärjestys perustuvat tähän yhteen lukuun — muuta sitä milloin vain, ja kaikki muu seuraa perässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitations, RSVP, accompagnants, régimes alimentaires et plan de table dépendent tous de ce chiffre — modifiez-le quand vous voulez, tout le reste suit."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozivnice, RSVP-ovi, pratnje, prehrambene napomene i raspored sjedenja ovise o ovom jednom broju — promijenite ga kad god želite i sve se prilagodi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A meghívók, a visszajelzések, a kísérők, az étkezési igények és az ültetési rend mind ezen az egy számon múlnak — változtasd meg bármikor, és minden követi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boðskort, RSVP, fylgdargestir, athugasemdir um mataræði og borðaskipan hanga öll á þessari einu tölu — breyttu henni hvenær sem er og allt fylgir með."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviti, RSVP, accompagnatori, note alimentari e disposizione dei tavoli dipendono tutti da questo numero: cambiatelo quando volete e tutto il resto si aggiorna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "招待状も、出欠も、同伴者も、食事のメモも、席次も、すべてこの人数が基準になります — いつ変更しても、すべてが自動で追随します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "청첩장, 참석 여부, 동반자, 식사 요청 사항, 좌석 배치가 모두 이 숫자 하나에 연결돼요 — 언제든 바꾸면 나머지도 따라와요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ielūgumi, RSVP atbildes, pavadoņi, uztura piezīmes un sēdvietas balstās uz šo vienu skaitli — maini to jebkurā brīdī, un viss pielāgosies."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitasjoner, RSVP, følge, kostbehov og bordplassering henger alle på dette ene tallet – endre det når som helst, så følger resten med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitnodigingen, RSVP's, introducés, dieetwensen en de tafelindeling hangen allemaal aan dit ene getal — pas het aan wanneer je wilt en de rest volgt vanzelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaproszenia, RSVP, osoby towarzyszące, preferencje żywieniowe i plan stołów zależą od tej jednej liczby — zmieńcie ją kiedy chcecie, reszta dostosuje się sama."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convites, RSVPs, acompanhantes, restrições alimentares e mesas dependem desse número — mude quando quiser e todo o resto acompanha."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitațiile, RSVP-urile, însoțitorii, preferințele alimentare și așezarea la mese pornesc toate de la acest număr — schimbă-l oricând și restul se ajustează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приглашения, RSVP, сопровождающие, пожелания по еде и рассадка зависят от этой цифры — измените её в любой момент, и всё пересчитается."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozvánky, RSVP, sprievod, stravovacie poznámky aj zasadací poriadok vychádzajú z tohto jedného čísla — kedykoľvek ho zmeňte a všetko sa prispôsobí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vabila, RSVP-ji, spremljevalci, prehranske opombe in sedežni red – vse je odvisno od te ene številke. Spremenita jo kadar koli in vse se prilagodi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inbjudningar, OSA, medföljande, matpreferenser och bordsplacering hänger alla på den här siffran – ändra den när du vill så följer allt annat med."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การ์ดเชิญ RSVP ผู้ติดตาม โน้ตเรื่องอาหาร และผังที่นั่ง ล้วนอ้างอิงจากตัวเลขนี้ — เปลี่ยนเมื่อไรก็ได้ แล้วทุกอย่างจะปรับตาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Davetiyeler, RSVP'ler, refakatçiler, beslenme notları ve oturma düzeni hep bu tek sayıya bağlı — istediğiniz zaman değiştirin, gerisi kendiliğinden uyum sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрошення, RSVP, супутники, харчові нотатки й розсадка залежать від цієї однієї цифри — змініть її будь-коли, і все підлаштується."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiệp mời, RSVP, người đi cùng, ghi chú ăn uống và sơ đồ chỗ ngồi đều dựa vào con số này — đổi lúc nào cũng được, mọi thứ sẽ tự điều chỉnh theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请柬、RSVP、同行宾客、饮食备注和座位安排都取决于这一个数字——随时改，其他都会跟着更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喜帖、RSVP、攜伴、飲食備註和座位安排全都以這個數字為基準 — 隨時修改，其他都會跟著更新。"
          }
        }
      }
    },
    "Invited" : {
      "localizations" : {
