          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium показывает RSVP, блюда и группы одним взглядом."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
