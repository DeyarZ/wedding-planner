    "That's normal at your stage — and every single one of them is already on your list, in the right order, with a date." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا طبيعي في مرحلتك — وكل واحد منها موجود بالفعل في قائمتك، بالترتيب الصحيح، وبتاريخ محدد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve vaší fázi je to normální — a všechny už máte v seznamu, ve správném pořadí a s datem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er helt normalt der, hvor I er — og hver eneste af dem står allerede på jeres liste, i den rigtige rækkefølge og med en dato."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Völlig normal an diesem Punkt — und jede einzelne Aufgabe steht schon auf eurer Liste, in der richtigen Reihenfolge, mit Datum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es lo normal en vuestra etapa, y todas están ya en vuestra lista, en el orden correcto y con fecha."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinu etapis on see täiesti tavaline — ja iga üksik neist on juba sinu nimekirjas, õiges järjekorras ja kuupäevaga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se on täysin normaalia tässä vaiheessa — ja jokainen niistä on jo listallasi, oikeassa järjestyksessä ja päivättynä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est normal à ce stade — et elles sont déjà toutes sur votre liste, dans le bon ordre, avec une date."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To je normalno u vašoj fazi — i svaka je od njih već na vašem popisu, u pravom redoslijedu i s datumom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez teljesen normális ebben a szakaszban — és mindegyik már ott van a listádon, a megfelelő sorrendben, dátummal."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Það er eðlilegt á þínu stigi — og hvert einasta þeirra er þegar á listanum þínum, í réttri röð og með dagsetningu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È normale a questo punto: sono già tutte nella vostra lista, nell'ordine giusto e con una data."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今の段階ではごく普通のことです — そしてそのすべてが、すでに日付つきで正しい順番にリストへ入っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 단계에서는 당연한 일이에요 — 그리고 그 모든 게 이미 날짜와 순서까지 정해져 목록에 들어가 있어요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavā posmā tas ir normāli — un ikviens no tiem jau ir tavā sarakstā, pareizā secībā un ar datumu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er helt normalt der dere er nå – og hver eneste av dem står allerede på listen deres, i riktig rekkefølge, med en dato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat is normaal in deze fase — en ze staan stuk voor stuk al op je lijst, in de juiste volgorde, met een datum."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To normalne na Waszym etapie — a każda z tych rzeczy jest już na Waszej liście, w odpowiedniej kolejności i z datą."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso é normal nesta fase — e cada uma delas já está na sua lista, na ordem certa e com data."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E normal în etapa în care sunteți — și fiecare dintre ele este deja pe lista voastră, în ordinea potrivită, cu un termen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вашем этапе это нормально — и все они уже в вашем списке, в правильном порядке и с датами."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vo vašej fáze je to úplne normálne — a každá jedna z nich už je vo vašom zozname, v správnom poradí a s dátumom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V vajini fazi je to povsem običajno – in prav vsaka od teh stvari je že na vajinem seznamu, v pravem vrstnem redu in z datumom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det är helt normalt i din fas – och varenda en av dem finns redan på din lista, i rätt ordning, med ett datum."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในช่วงนี้เป็นเรื่องปกติมาก — และทุกอย่างอยู่ในรายการของคุณแล้ว เรียงตามลำดับ พร้อมวันที่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulunduğunuz aşamada bu gayet normal — ve hepsi zaten listenizde, doğru sırayla ve tarihiyle duruyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вашому етапі це нормально — і кожна з них уже є у вашому списку, у правильному порядку та з датою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ở giai đoạn của bạn thì đó là chuyện bình thường — và từng việc một đều đã nằm trong danh sách của bạn, đúng thứ tự, kèm ngày tháng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你们这个阶段这很正常——而且每一件都已经在清单上了，顺序排好，日期也定好了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你現在這個階段很正常 — 而且每一項都已經在你的清單上了，順序排好、日期也標好了。"
          }
        }
      }
    },
