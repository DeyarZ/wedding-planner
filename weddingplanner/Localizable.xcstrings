    "Tell us what you'd love to see, or what went wrong. We read every message." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخبرنا بما تود رؤيته، أو بما لم يسر على ما يرام. نحن نقرأ كل رسالة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napište nám, co byste rádi viděli nebo co se pokazilo. Čteme každou zprávu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortæl os, hvad I gerne vil se, eller hvad der gik galt. Vi læser hver eneste besked."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag uns, was du dir wünschst oder was schiefging. Wir lesen jede Nachricht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntanos qué te gustaría ver o qué falló. Leemos cada mensaje."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räägi meile, mida sooviksid näha või mis läks valesti. Loeme iga sõnumit."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerro, mitä haluaisit nähdä tai mikä meni pieleen. Luemme jokaisen viestin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites-nous ce que vous aimeriez voir ou ce qui a bugué. Nous lisons chaque message."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recite nam što biste voljeli vidjeti ili što nije bilo u redu. Čitamo svaku poruku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Írd meg, mit szeretnél látni, vagy mi nem működött. Minden üzenetet elolvasunk."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segðu okkur hvað þig langar að sjá eða hvað fór úrskeiðis. Við lesum öll skilaboð."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicci cosa vorresti vedere o cosa è andato storto. Leggiamo ogni messaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんな機能がほしい、ここがうまくいかない — どんなことでもお聞かせください。すべてのメッセージに目を通しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보고 싶은 기능이나 불편했던 점을 알려주세요. 모든 메시지를 읽고 있어요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastāsti, ko labprāt gribētu redzēt vai kas nav izdevies. Mēs izlasām katru ziņu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortell oss hva du ønsker deg, eller hva som gikk galt. Vi leser hver eneste melding."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertel ons wat je graag zou willen zien, of wat er misging. We lezen elk bericht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napiszcie, co chcielibyście zobaczyć albo co poszło nie tak. Czytamy każdą wiadomość."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conte o que você adoraria ver, ou o que deu errado. Lemos todas as mensagens."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spune-ne ce ți-ar plăcea să vezi sau ce nu a mers. Citim fiecare mesaj."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расскажите, что вы хотели бы увидеть или что пошло не так. Мы читаем каждое сообщение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napíšte nám, čo by ste radi videli alebo čo nefungovalo. Čítame každú správu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povejta nam, kaj bi rada videla ali kaj je šlo narobe. Preberemo vsako sporočilo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berätta vad du skulle vilja se, eller vad som gick fel. Vi läser varje meddelande."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บอกเราว่าคุณอยากเห็นอะไร หรือมีอะไรผิดพลาด เราอ่านทุกข้อความ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görmek istediğinizi ya da ters gideni bize yazın. Her mesajı okuyoruz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розкажіть, що б ви хотіли бачити або що пішло не так. Ми читаємо кожне повідомлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy cho chúng tôi biết bạn muốn thấy điều gì, hoặc điều gì chưa ổn. Chúng tôi đọc mọi tin nhắn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉我们你们希望看到什么，或者哪里出了问题。每一条我们都会看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告訴我們你想看到什麼，或是哪裡出了問題。每一則訊息我們都會看。"
          }
        }
      }
    },
