    "Hold the circle to promise %@ that you'll plan this together — no last-minute panic, no forgotten deadlines.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den Kreis gedrückt und versprich %@, dass ihr das zusammen plant — keine Panik auf den letzten Drücker, keine vergessenen Fristen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el círculo para prometer a %@ que lo organizaréis juntos: sin agobios de última hora ni fechas olvidadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le cercle pour promettre à %@ que vous organiserez tout ensemble — sans panique de dernière minute, sans échéance oubliée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto il cerchio per promettere a %@ che organizzerete tutto insieme: niente panico dell'ultimo minuto, niente scadenze dimenticate."
          }
        }
      }
    },
