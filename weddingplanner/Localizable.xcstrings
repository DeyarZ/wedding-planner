    "Don't forget to add your guests! Manage RSVPs effortlessly 👥" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تنسَ إضافة ضيوفك! أدر تأكيدات الحضور بلا عناء 👥"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezapomeňte přidat hosty! Spravujte RSVP bez námahy 👥"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glem ikke at tilføje jeres gæster! Styr RSVP'er uden besvær 👥"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergiss deine Gäste nicht! Verwalte Zusagen ganz einfach 👥"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡No olvides añadir invitados! Gestiona las confirmaciones sin esfuerzo 👥"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ära unusta külalisi lisada! Halda RSVP-sid mängleva kergusega 👥"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muista lisätä vieraasi! Hallitse RSVP-vastauksia vaivattomasti 👥"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'oubliez pas vos invités ! Gérez les réponses sans effort 👥"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne zaboravite dodati goste! Upravljajte RSVP-ovima bez muke 👥"
