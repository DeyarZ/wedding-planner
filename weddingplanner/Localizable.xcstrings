          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อใจผู้ให้บริการของคุณ\nพวกเขาก็อยากให้วันของคุณสวยงามเหมือนกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
