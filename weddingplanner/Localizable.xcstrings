          "stringUnit" : {
            "state" : "translated",
            "value" : "Mēs pateiksim, pirms izmēģinājums beidzas, lai nekas nebūtu pārsteigums."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi sier fra før prøveperioden avsluttes, så ingenting kommer overraskende."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We laten het je weten voordat de proefperiode afloopt, zodat niets je verrast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damy znać przed końcem okresu próbnego, żeby nic Was nie zaskoczyło."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisamos antes de o teste terminar, para que nada seja surpresa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îți spunem înainte să se încheie proba, ca să nu fie nicio surpriză."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы предупредим до окончания пробного периода, чтобы ничего не стало неожиданностью."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dáme vám vedieť pred koncom skúšobnej verzie, aby vás nič neprekvapilo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povedali vama bomo, preden se preizkus konča, tako da ne bo presenečenj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi säger till innan provperioden tar slut, så att inget kommer som en överraskning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราจะบอกคุณก่อนการทดลองใช้จะสิ้นสุด จะได้ไม่มีอะไรมาเซอร์ไพรส์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deneme bitmeden size haber veririz, hiçbir şey sürpriz olmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми попередимо вас перед завершенням пробного періоду, щоб не було жодних сюрпризів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi sẽ báo trước khi bản dùng thử kết thúc, để không có gì bất ngờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试用结束前我们会告诉你们，不会有任何意外。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試用結束前我們會先通知你，不會有任何意外。"
          }
        }
      }
    },
