    "Deadlines are dated backwards from your wedding day and remind you in time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المواعيد النهائية محسوبة بالعد التنازلي من يوم زفافك، وتذكّرك في الوقت المناسب."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termíny se počítají zpětně od vašeho svatebního dne a připomenou se včas."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deadlines er dateret baglæns fra jeres bryllupsdag og minder jer om dem i god tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fristen zählen rückwärts von eurem Hochzeitstag und erinnern euch rechtzeitig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fechas límite se calculan hacia atrás desde el día de la boda y os avisan a tiempo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tähtajad arvestatakse tagurpidi sinu pulmapäevast ja tuletavad end õigel ajal meelde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Määräajat lasketaan taaksepäin hääpäivästäsi ja muistuttavat sinua ajoissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les échéances sont calculées à rebours depuis le jour J et vous préviennent à temps."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rokovi se računaju unatrag od dana vjenčanja i podsjete vas na vrijeme."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A határidők az esküvőd napjától visszafelé számolódnak, és időben szólnak."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frestir eru reiknaðir aftur á bak frá brúðkaupsdeginum og minna þig á í tæka tíð."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scadenze sono calcolate a ritroso dal giorno del matrimonio e vi avvisano in tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期限は結婚式当日から逆算して設定され、間に合うタイミングでお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마감일은 결혼식 당일을 기준으로 거꾸로 계산되고, 늦지 않게 미리 알려드려요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termiņi tiek atskaitīti atpakaļ no tavas kāzu dienas un atgādina savlaicīgi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fristene regnes bakover fra bryllupsdagen og minner dere på i god tid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deadlines worden teruggerekend vanaf jullie trouwdag en herinneren je op tijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminy liczymy wstecz od dnia ślubu, a przypomnienia przychodzą w porę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os prazos são contados de trás para frente a partir do dia do casamento e avisam vocês a tempo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termenele sunt calculate înapoi de la ziua nunții și îți amintesc din timp."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сроки отсчитываются назад от дня свадьбы и напоминают о себе вовремя."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termíny sa počítajú spätne od vášho svadobného dňa a pripomenú sa vám včas."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roki so izračunani nazaj od vajinega poročnega dne in vaju pravočasno opomnijo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla deadlines räknas baklänges från din bröllopsdag och påminner dig i tid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำหนดเวลาทุกอย่างนับถอยหลังจากวันแต่งงานของคุณ และเตือนคุณได้ทันเวลาเสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son tarihler düğün gününüzden geriye doğru hesaplanır ve size zamanında hatırlatılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дедлайни відраховуються назад від дня весілля й нагадують про себе вчасно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các hạn chót được tính ngược từ ngày cưới của bạn và nhắc bạn đúng lúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有截止日期都从婚礼当天倒推安排，并会及时提醒你们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有截止日都是從婚禮當天往回推算，並且會及時提醒你。"
          }
        }
      }
    },
