    "Whatever is worrying you, it is already a task, a category or a reminder in your plan." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أيًّا كان ما يقلقك، فهو موجود بالفعل كمهمة أو فئة أو تذكير في خطتك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ať vás trápí cokoli, už je to ve vašem plánu jako úkol, kategorie nebo připomínka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uanset hvad der bekymrer jer, er det allerede en opgave, en kategori eller en påmindelse i jeres plan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was auch immer euch Sorgen macht — in eurem Plan ist es schon eine Aufgabe, eine Kategorie oder eine Erinnerung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sea lo que sea lo que os preocupa, ya es una tarea, una categoría o un recordatorio dentro de vuestro plan."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mis sind ka ei muretseks — see on sinu plaanis juba ülesanne, kategooria või meeldetuletus."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikä sinua huolettaakin, se on jo tehtävä, kategoria tai muistutus suunnitelmassasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quoi qu'il vous inquiète, c'est déjà une tâche, une catégorie ou un rappel dans votre plan."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Što god vas brine, već je zadatak, kategorija ili podsjetnik u vašem planu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bármi is aggaszt, az már most is feladat, kategória vagy emlékeztető a tervedben."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvað sem veldur þér áhyggjum er það þegar orðið að verkefni, flokki eða áminningu í áætluninni þinni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualunque cosa vi preoccupi, nel vostro piano è già un'attività, una categoria o un promemoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どんな心配ごとも、すでにプランの中のタスク・カテゴリー・リマインドになっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무엇이 걱정되든, 그건 이미 플랜 속의 할 일이거나 카테고리이거나 알림이에요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lai kas tevi satrauktu, tavā plānā tas jau ir uzdevums, kategorija vai atgādinājums."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uansett hva som bekymrer dere, er det allerede en oppgave, en kategori eller en påminnelse i planen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waar je je ook zorgen om maakt, het staat al als taak, categorie of herinnering in jullie plan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cokolwiek Was martwi, jest już w Waszym planie jako zadanie, kategoria albo przypomnienie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seja o que for que esteja preocupando vocês, já é uma tarefa, uma categoria ou um lembrete no seu plano."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orice te îngrijorează este deja o sarcină, o categorie sau un memento în planul tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что бы вас ни беспокоило, в вашем плане это уже задача, категория или напоминание."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nech vás trápi čokoľvek, vo vašom pláne to už je ako úloha, kategória alebo pripomienka."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karkoli vaju skrbi, je v vajinem načrtu že opravilo, kategorija ali opomnik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad du än oroar dig för finns det redan som en uppgift, en kategori eller en påminnelse i din plan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ว่าคุณจะกังวลเรื่องอะไร มันอยู่ในแผนของคุณแล้ว ทั้งในรูปสิ่งที่ต้องทำ หมวดงบประมาณ หรือการแจ้งเตือน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sizi ne endişelendiriyorsa, o zaten planınızda bir görev, bir kategori ya da bir hatırlatma olarak var."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
