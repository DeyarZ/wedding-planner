        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 비용이 12개 카테고리 중 한곳에 정리돼요. 무언가를 결정하기 전에 남은 예산을 늘 알 수 있어요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
