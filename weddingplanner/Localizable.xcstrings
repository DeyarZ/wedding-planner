    "If you have any questions about this Privacy Policy, please contact us. We reserve the right to update this policy at any time, and we will notify you of any material changes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كانت لديك أي أسئلة حول سياسة الخصوصية هذه، فيُرجى التواصل معنا. ونحتفظ بالحق في تحديث هذه السياسة في أي وقت، وسنُعلمك بأي تغييرات جوهرية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máte-li k těmto Zásadám ochrany osobních údajů jakékoli dotazy, kontaktujte nás prosím. Vyhrazujeme si právo tyto zásady kdykoli aktualizovat a o všech podstatných změnách vás budeme informovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du har spørgsmål til denne privatlivspolitik, er du velkommen til at kontakte os. Vi forbeholder os retten til at opdatere politikken når som helst, og vi giver dig besked om væsentlige ændringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Fragen zu dieser Datenschutzerklärung kontaktiere uns. Wir können diese Erklärung jederzeit aktualisieren und informieren dich über wesentliche Änderungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tienes preguntas sobre esta política, contáctanos. Podemos actualizarla en cualquier momento y te avisaremos de cambios importantes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui sul on selle privaatsuspoliitika kohta küsimusi, võta meiega ühendust. Jätame endale õiguse seda poliitikat igal ajal uuendada ja teavitame sind kõigist olulistest muudatustest."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos sinulla on kysyttävää tästä tietosuojakäytännöstä, ota meihin yhteyttä. Pidätämme oikeuden päivittää tätä käytäntöä milloin tahansa ja ilmoitamme sinulle olennaisista muutoksista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour toute question sur cette politique, contactez-nous. Nous pouvons la mettre à jour à tout moment et vous informerons des changements importants."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako imate pitanja o ovim Pravilima privatnosti, obratite nam se. Zadržavamo pravo izmjene ovih pravila u bilo kojem trenutku i obavijestit ćemo vas o svim bitnim promjenama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha bármilyen kérdésed van a jelen Adatvédelmi tájékoztatóval kapcsolatban, kérjük, lépj kapcsolatba velünk. Fenntartjuk a jogot, hogy a tájékoztatót bármikor frissítsük, és minden lényeges változásról értesítünk."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ef þú hefur spurningar um þessa persónuverndarstefnu skaltu hafa samband við okkur. Við áskiljum okkur rétt til að uppfæra stefnuna hvenær sem er og við látum þig vita um allar verulegar breytingar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per domande su questa informativa, contattaci. Possiamo aggiornarla in qualsiasi momento e ti avviseremo di modifiche rilevanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本プライバシーポリシーについてご不明な点がございましたら、お問い合わせください。当社は本ポリシーをいつでも更新する権利を留保し、重要な変更がある場合にはお知らせいたします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본 개인정보 처리방침에 대해 궁금한 점이 있으시면 문의해 주세요. 당사는 언제든지 본 방침을 변경할 권리가 있으며, 중요한 변경 사항이 있을 경우 안내해 드립니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja tev ir jautājumi par šo privātuma politiku, lūdzu, sazinies ar mums. Mēs paturam tiesības jebkurā laikā atjaunināt šo politiku un informēsim tevi par būtiskām izmaiņām."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du har spørsmål om denne personvernerklæringen, ta gjerne kontakt med oss. Vi forbeholder oss retten til å oppdatere erklæringen når som helst, og vi varsler deg om vesentlige endringer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heb je vragen over dit Privacybeleid, neem dan contact met ons op. We behouden ons het recht voor dit beleid op elk moment bij te werken en we informeren je over belangrijke wijzigingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli masz pytania dotyczące niniejszej Polityki prywatności, skontaktuj się z nami. Zastrzegamy sobie prawo do aktualizacji tej polityki w dowolnym momencie i poinformujemy Cię o wszelkich istotnych zmianach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você tiver dúvidas sobre esta Política de Privacidade, entre em contato conosco. Reservamo-nos o direito de atualizar esta política a qualquer momento e avisaremos sobre qualquer alteração relevante."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă ai întrebări despre această Politică de confidențialitate, te rugăm să ne contactezi. Ne rezervăm dreptul de a actualiza această politică oricând și te vom anunța cu privire la orice modificare importantă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если у вас есть вопросы по этой Политике конфиденциальности, свяжитесь с нами. Мы оставляем за собой право обновлять эту политику в любое время и уведомим вас о существенных изменениях."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak máte akékoľvek otázky k týmto Zásadám ochrany osobných údajov, kontaktujte nás. Vyhradzujeme si právo tieto zásady kedykoľvek aktualizovať a o všetkých podstatných zmenách vás budeme informovať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če imate kakršna koli vprašanja o tej politiki zasebnosti, nas kontaktirajte. Pridržujemo si pravico, da to politiko kadar koli posodobimo, o vseh bistvenih spremembah pa vas bomo obvestili."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du har frågor om denna integritetspolicy är du välkommen att kontakta oss. Vi förbehåller oss rätten att uppdatera policyn när som helst och meddelar dig vid väsentliga ändringar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากคุณมีคำถามเกี่ยวกับนโยบายความเป็นส่วนตัวนี้ กรุณาติดต่อเรา เราขอสงวนสิทธิ์ในการปรับปรุงนโยบายนี้ได้ทุกเมื่อ และจะแจ้งให้คุณทราบหากมีการเปลี่ยนแปลงที่สำคัญ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Gizlilik Politikası hakkında sorularınız varsa lütfen bizimle iletişime geçin. Bu politikayı dilediğimiz zaman güncelleme hakkımızı saklı tutarız ve önemli değişiklikleri size bildiririz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо у вас є запитання щодо цієї Політики конфіденційності, зв’яжіться з нами. Ми залишаємо за собою право оновлювати цю політику будь-коли й повідомимо вас про будь-які суттєві зміни."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn có bất kỳ câu hỏi nào về Chính sách quyền riêng tư này, vui lòng liên hệ với chúng tôi. Chúng tôi có quyền cập nhật chính sách này bất cứ lúc nào và sẽ thông báo cho bạn về mọi thay đổi quan trọng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您对本隐私政策有任何疑问，请联系我们。我们保留随时更新本政策的权利，如有重大变更，我们会通知您。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若你對本隱私權政策有任何疑問，歡迎與我們聯絡。我們保留隨時更新本政策的權利，並會在有重大變更時通知你。"
          }
        }
      }
    },
