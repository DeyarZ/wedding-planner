    "Hold the circle to promise %@ that you'll plan this together — no last-minute panic, no forgotten deadlines." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطوّلًا على الدائرة لتَعِد %@ بأنكما ستخططان معًا — بلا ارتباك في اللحظة الأخيرة، وبلا مواعيد منسية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte kroužek a slibte %@, že to naplánujete spolu — žádná panika na poslední chvíli, žádné zapomenuté termíny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold på cirklen for at love %@, at I planlægger det her sammen — ingen panik i sidste øjeblik, ingen glemte deadlines."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Kreis gedrückt und versprich %@, dass ihr das zusammen plant — keine Panik auf den letzten Drücker, keine vergessenen Fristen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el círculo para prometer a %@ que lo organizaréis juntos: sin agobios de última hora ni fechas olvidadas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoia ringi all ja anna lubadus: sina ja %@ planeerite selle koos — ei mingit viimase hetke paanikat ega unustatud tähtaegu."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä ympyrää pohjassa ja lupaa %@:lle, että suunnittelette tämän yhdessä — ei viime hetken paniikkia, ei unohtuneita määräaikoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le cercle pour promettre à %@ que vous organiserez tout ensemble — sans panique de dernière minute, sans échéance oubliée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držite krug i obećajte %@ da ćete ovo planirati zajedno — bez panike u zadnji čas i bez zaboravljenih rokova."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsd nyomva a kört, és ígérd meg %@ számára, hogy együtt tervezitek meg — nincs utolsó pillanatos pánik, nincsenek elfelejtett határidők."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haltu inni hringnum til að lofa %@ að þið skipuleggið þetta saman — ekkert stress á síðustu stundu, engir gleymdir frestir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto il cerchio per promettere a %@ che organizzerete tutto insieme: niente panico dell'ultimo minuto, niente scadenze dimenticate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "円を長押しして、%@に「一緒に準備する」と約束しましょう — 直前の慌ただしさも、忘れられた期限もなしで。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원을 길게 눌러 %@님에게 함께 준비하겠다고 약속하세요 — 막판에 허둥댈 일도, 놓치는 마감일도 없이."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turi nospiestu apli, lai apsolītu %@, ka plānosiet to kopā — bez panikas pēdējā brīdī un aizmirstiem termiņiem."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold inne sirkelen for å love %@ at dere planlegger dette sammen – ingen panikk på slutten, ingen glemte frister."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de cirkel vast om %@ te beloven dat jullie dit samen plannen — geen paniek op het laatste moment, geen vergeten deadlines."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj koło, aby obiecać %@, że zaplanujecie to razem — bez paniki na ostatnią chwilę i zapomnianych terminów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure o círculo para prometer a %@ que vocês vão organizar tudo juntos — sem pânico de última hora, sem prazos esquecidos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ține apăsat cercul ca promisiune pentru %@: veți plănui totul împreună — fără panică pe ultima sută de metri, fără termene uitate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте круг, чтобы пообещать %@, что вы всё спланируете вместе — без паники в последний момент и забытых сроков."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte kruh a sľúbte %@, že to naplánujete spolu — žiadna panika na poslednú chvíľu, žiadne zabudnuté termíny."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridržita krog in obljubita %@, da bosta to načrtovala skupaj – brez panike v zadnjem trenutku, brez pozabljenih rokov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll in cirkeln för att lova %@ att ni planerar det här tillsammans – ingen panik i sista minuten, inga glömda deadlines."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กดวงกลมค้างไว้เพื่อสัญญากับ %@ ว่าคุณจะวางแผนงานนี้ไปด้วยกัน — ไม่มีการวิ่งวุ่นนาทีสุดท้าย ไม่มีกำหนดเวลาที่ลืม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daireyi basılı tutun ve %@ ile bunu birlikte planlayacağınıza söz verin — son dakika telaşı yok, unutulan son tarih yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утримуйте коло, щоб пообіцяти %@, що плануватимете все разом — без паніки в останню мить і забутих дедлайнів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ vòng tròn để hứa với %@ rằng hai bạn sẽ cùng nhau lo liệu — không cuống cuồng phút chót, không quên hạn chót nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按圆圈，向 %@ 承诺你们会一起筹备这场婚礼——不临时慌乱，不漏掉任何期限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住圓圈，向 %@ 承諾你們會一起把這件事規劃好 — 不臨時慌張，也不漏掉任何期限。"
          }
        }
      }
    },
