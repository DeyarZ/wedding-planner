    "Give everyone — especially travelling guests — a heads up" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نبّه الجميع مبكرًا — خصوصًا الضيوف المسافرين"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejte všem — hlavně přespolním hostům — vědět dopředu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv alle — især tilrejsende gæster — et praj i god tid"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebt allen früh Bescheid — vor allem den Gästen, die anreisen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisad a todos con tiempo, sobre todo a los que vienen de fuera"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna kõigile — eriti kaugemalt tulijatele — varakult teada"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna kaikille — etenkin kaukaa tuleville — ennakkotieto"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévenez tout le monde — surtout les invités qui viennent de loin"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Javite svima na vrijeme — osobito gostima koji putuju"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szólj mindenkinek időben — főleg a messziről érkező vendégeknek"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Láttu alla vita — sérstaklega gesti sem koma langt að"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvisate tutti in anticipo, soprattutto chi arriva da lontano"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "みなさんに、特に遠方のゲストに、早めのお知らせを"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두에게 미리 알려주세요 — 특히 멀리서 오는 하객에게"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brīdini visus laikus — īpaši tos, kas ceļos"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi alle – særlig tilreisende gjester – et tidlig varsel"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef iedereen — en zeker gasten die moeten reizen — op tijd een seintje"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uprzedźcie wszystkich — zwłaszcza gości z daleka"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avise todo mundo com antecedência — principalmente quem vem de longe"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anunță din timp pe toată lumea — mai ales pe invitații care vin de departe"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предупредите всех заранее, особенно тех, кто приедет издалека"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dajte všetkým — najmä hosťom zďaleka — vedieť vopred"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pravočasno obvestita vse, še posebej goste, ki potujejo"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge alla – särskilt långväga gäster – en förvarning"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บอกทุกคนล่วงหน้า โดยเฉพาะแขกที่ต้องเดินทางมาไกล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herkese, özellikle uzaktan gelecek misafirlere, önceden haber verin"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попередьте всіх, особливо тих, хто їде здалеку"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo trước cho mọi người — nhất là những khách mời ở xa"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提前通知所有人——尤其是要远道而来的宾客"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先讓大家知道 — 尤其是要遠道而來的賓客"
          }
        }
      }
    },
