    "Photos stay hidden until you tap Reveal — like developing the film the morning after." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Fotos bleiben verborgen, bis du auf „Enthüllen“ tippst – wie das Entwickeln des Films am Morgen danach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos permanecen ocultas hasta que pulsas Revelar, como cuando se revelaba el carrete a la mañana siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos restent cachées jusqu'à ce que vous appuyiez sur Révéler, comme un film qu'on développe le lendemain matin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto restano nascoste finché non tocchi Svela, come sviluppare il rullino la mattina dopo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto's blijven verborgen tot je op Onthullen tikt – zoals het ontwikkelen van het rolletje de ochtend erna."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos ficam escondidas até você tocar em Revelar, como revelar o filme na manhã seguinte."
          }
        }
      }
    },
