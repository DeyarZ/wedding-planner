          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium na prvi pogled razčleni RSVP-je, menije in skupine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium visar OSA, menyval och grupper i en enda överblick."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พรีเมียมแยกให้เห็น RSVP อาหาร และกลุ่มแขก ได้ในพริบตา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium; RSVP'leri, yemekleri ve grupları tek bakışta özetler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium показує RSVP, страви та групи як на долоні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium hiển thị chi tiết RSVP, món ăn và nhóm khách chỉ trong một cái nhìn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高级版让 RSVP、餐食和分组一目了然。"
