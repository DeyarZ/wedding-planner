    "Table settings, lighting and the little details people remember" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنسيق الطاولات والإضاءة والتفاصيل الصغيرة التي يتذكرها الناس"
