    "30 days until you say 'I do'! How exciting is this?!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 يومًا ويحين موعد «قبلت»! كم هذا مشوّق!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbývá 30 dní, než si řeknete své „ano“! Není to úžasné?!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 dage til I siger ja! Hvor er det spændende!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch 30 Tage bis zum Ja-Wort! Wie aufregend ist das bitte?!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡30 días para el 'sí, quiero'! ¡Qué emoción!"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 päeva selleni, kui ütled „jah“! Kui põnev see on?!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 päivää siihen, kun sanot 'tahdon'! Onpa jännittävää!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus que 30 jours avant le grand oui ! C'est fou, non ?!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još 30 dana do vašeg 'Da'! Kako uzbudljivo!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 nap, és kimondod az igent! Hát nem izgalmas?!"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 dagar þar til þú segir „já“! Er þetta ekki spennandi?!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 giorni al tuo sì! Che emozione!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「誓います」の日まであと30日！ワクワクしますね！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결혼식까지 30일 남았어요! 정말 설레지 않나요?!"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vēl 30 dienas līdz tavam „Jā”! Cik aizraujoši!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 dager til du sier ja! Hvor spennende er ikke det?!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog 30 dagen tot jullie 'ja' zeggen! Hoe spannend is dit?!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 dni do Waszego „tak”! Ale to ekscytujące!"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltam 30 dias para você dizer 'sim'! Que emoção, né?!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 de zile până spui „Da”! Ce emoționant, nu?!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 дней до твоего «да»! Ну разве не волнительно?!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 dní do vášho „áno“! Nie je to úžasné?!"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Še 30 dni do vajinega 'da'! Kako razburljivo!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 dagar tills ni säger ja! Visst är det spännande?!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อีก 30 วันก็ถึงวันที่คุณจะพูดว่า 'ฉันยินดี' แล้ว! ตื่นเต้นสุด ๆ ไปเลยใช่ไหม!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Evet' demenize 30 gün kaldı! Ne kadar heyecan verici!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 днів до вашого «так»! Хіба це не хвилююче?!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Còn 30 ngày nữa là bạn nói lời 'Em đồng ý'! Háo hức chưa nào?!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距离你说「我愿意」只剩 30 天！是不是超级期待？！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距離你說出「我願意」只剩 30 天！是不是超期待？！"
          }
        }
      }
    },
