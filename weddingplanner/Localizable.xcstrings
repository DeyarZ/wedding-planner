    "Tomorrow you marry your best friend! Get some rest, beautiful bride!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غدًا تتزوّجين أعزّ صديق لكِ! خذي قسطًا من الراحة يا عروسنا الجميلة!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zítra si vezmete svého nejlepšího přítele! Odpočiňte si, krásná nevěsto!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I morgen gifter du dig med din bedste ven! Få hvilet ud, smukke brud!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgen heiratest du deinen besten Freund! Ruh dich gut aus, wunderschöne Braut!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Mañana te casas con tu mejor amigo! ¡Descansa, novia preciosa!"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homme abiellud oma parima sõbraga! Puhka korralikult, kaunis pruut!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huomenna menet naimisiin parhaan ystäväsi kanssa! Lepää hyvin, kaunis morsian!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demain, vous épousez votre meilleur ami ! Reposez-vous, jolie mariée !"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sutra se vjenčate sa svojim najboljim prijateljem! Odmorite se, prekrasna mladenko!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holnap hozzámész a legjobb barátodhoz! Pihenj egyet, gyönyörű menyasszony!"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Á morgun giftist þú besta vini þínum! Hvíldu þig vel, fallega brúður!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domani sposi il tuo migliore amico! Riposati, splendida sposa!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明日はいよいよ最愛の人と結婚する日！素敵な花嫁さん、今日はゆっくり休んでくださいね"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내일이면 가장 친한 친구와 결혼해요! 오늘은 푹 쉬어요, 아름다운 신부님!"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rīt tu precies ar savu labāko draugu! Atpūties, skaistā līgava!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I morgen gifter du deg med bestevennen din! Få deg litt hvile, vakre brud!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgen trouw je met je beste vriend! Rust lekker uit, mooie bruid!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jutro wychodzisz za mąż za swojego najlepszego przyjaciela! Odpocznij, piękna panno młoda!"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amanhã você casa com o seu melhor amigo! Descanse, noiva linda!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mâine te măriți cu cel mai bun prieten al tău! Odihnește-te, frumoasă mireasă!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завтра ты выходишь замуж за своего лучшего друга! Отдохни как следует, прекрасная невеста!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zajtra si beriete svojho najlepšieho priateľa! Oddýchnite si, krásna nevesta!"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jutri se poročiš s svojim najboljšim prijateljem! Naspi se, čudovita nevesta!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imorgon gifter du dig med din bästa vän! Vila upp dig, vackra brud!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พรุ่งนี้คุณจะได้แต่งงานกับเพื่อนซี้ที่สุดแล้ว! พักผ่อนเยอะ ๆ นะเจ้าสาวคนสวย!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yarın en iyi arkadaşınızla evleniyorsunuz! Biraz dinlenin, güzel gelin!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завтра ви виходите заміж за свого найкращого друга! Відпочиньте, прекрасна наречена!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngày mai bạn sẽ kết hôn với người bạn thân nhất! Nghỉ ngơi đi nhé, cô dâu xinh đẹp!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明天你就要和最好的朋友结婚啦！好好休息，美丽的新娘！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明天你就要嫁給最好的朋友了！好好休息吧，美麗的新娘！"
          }
        }
      }
    },
