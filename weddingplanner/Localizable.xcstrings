          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo allora viene addebitato qualcosa e potete disdire prima in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "料金が発生するのはそのときからです — それまではいつでも解約できます。"
