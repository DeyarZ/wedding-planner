    "Please let us know if you have any questions!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتردّدوا في التواصل معنا إن كان لديكم أي استفسار!"
          }
        },
        "cs" : {
          "stringUnit" : {
