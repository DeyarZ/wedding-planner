            "value": "CHI SI SPOSA?"
          }
        }
      }
    },
    "WHO'S PLANNING THIS?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WER PLANT DAS ALLES?"
          }
        },
        "es": {
