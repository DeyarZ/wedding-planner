    "Every last cost lands in one of 12 categories, so you always know what is left before you commit to anything.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Ausgabe landet in einer von 12 Kategorien — so wisst ihr immer, was noch übrig ist, bevor ihr zusagt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta el último gasto entra en una de las 12 categorías, así siempre sabéis cuánto os queda antes de comprometeros con nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
