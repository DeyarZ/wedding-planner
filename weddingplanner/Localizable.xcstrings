    "Plan your dream wedding with ease. From budget tracking to guest management, we'll guide you through every magical moment." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطط لزفاف أحلامك بسهولة. من متابعة الميزانية إلى إدارة الضيوف، سنرافقك في كل لحظة ساحرة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naplánujte svatbu snů bez stresu. Od sledování rozpočtu po správu hostů vás provedeme každým kouzelným okamžikem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planlæg jeres drømmebryllup uden besvær. Fra budgetstyring til gæstehåndtering guider vi jer gennem hvert magisk øjeblik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plane deine Traumhochzeit mit Leichtigkeit. Vom Budget bis zur Gästeliste begleiten wir dich durch jeden magischen Moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifica la boda de tus sueños con facilidad. Del presupuesto a los invitados, te guiamos en cada momento mágico."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planeeri oma unistuste pulmi mängleva kergusega. Eelarve jälgimisest külaliste haldamiseni juhatame sind läbi iga võlutud hetke."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suunnittele unelmahäät vaivattomasti. Budjetin seurannasta vieraslistan hallintaan opastamme sinut jokaisen taianomaisen hetken läpi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organisez le mariage de vos rêves en toute simplicité. Du budget aux invités, nous vous guidons à chaque instant magique."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isplanirajte vjenčanje iz snova bez stresa. Od praćenja proračuna do upravljanja gostima, vodimo vas kroz svaki čaroban trenutak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tervezd meg könnyedén az álomesküvődet. A költségkövetéstől a vendégkezelésig végigkísérünk minden varázslatos pillanaton."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skipuleggðu draumabrúðkaupið áreynslulaust. Frá fjárhagsáætlun til gestalista leiðum við þig í gegnum hvert töfrandi augnablik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pianifica il matrimonio dei tuoi sogni con facilità. Dal budget agli ospiti, ti guidiamo in ogni momento magico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "理想の結婚式を、かんたんに。予算管理からゲスト管理まで、すべての大切な瞬間をご案内します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꿈꾸던 결혼식을 손쉽게 준비하세요. 예산 관리부터 하객 관리까지, 모든 특별한 순간을 함께할게요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plāno savas sapņu kāzas bez raizēm. No budžeta uzskaites līdz viesu pārvaldībai — mēs būsim līdzās katrā burvīgajā mirklī."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planlegg drømmebryllupet uten stress. Fra budsjettoppfølging til gjestehåndtering – vi guider dere gjennom hvert magiske øyeblikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan moeiteloos jullie droombruiloft. Van budget bijhouden tot gastenbeheer, wij begeleiden jullie door elk magisch moment."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaplanujcie wymarzony ślub bez stresu. Od śledzenia budżetu po zarządzanie gośćmi — poprowadzimy Was przez każdą magiczną chwilę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organize o casamento dos seus sonhos com facilidade. Do acompanhamento do orçamento à gestão dos convidados, guiamos vocês por cada momento mágico."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifică-ți nunta de vis fără stres. De la urmărirea bugetului până la gestionarea invitaților, te ghidăm prin fiecare moment magic."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Планируйте свадьбу мечты легко. От контроля бюджета до работы со списком гостей — мы проведём вас через каждый волшебный момент."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naplánujte si vysnívanú svadbu úplne ľahko. Od sledovania rozpočtu až po správu hostí vás prevedieme každým čarovným okamihom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanjsko poroko načrtujta brez naprezanja. Od spremljanja proračuna do upravljanja gostov vaju popeljemo skozi vsak čaroben trenutek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planera ditt drömbröllop med lätthet. Från budgetuppföljning till gästhantering guidar vi dig genom varje magiskt ögonblick."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางแผนงานแต่งงานในฝันได้อย่างง่ายดาย ตั้งแต่ติดตามงบประมาณไปจนถึงจัดการแขก เราจะพาคุณผ่านทุกช่วงเวลาแสนวิเศษ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hayalinizdeki düğünü zahmetsizce planlayın. Bütçe takibinden misafir yönetimine, her büyülü anda yanınızdayız."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плануйте весілля мрії легко. Від контролю бюджету до керування гостями — ми проведемо вас через кожну чарівну мить."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lên kế hoạch cho đám cưới trong mơ thật nhẹ nhàng. Từ theo dõi ngân sách đến quản lý khách mời, chúng tôi sẽ đồng hành cùng bạn qua từng khoảnh khắc diệu kỳ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻松筹备你们的梦想婚礼。从预算追踪到宾客管理，我们陪你们走过每一个美好瞬间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輕鬆規劃你的夢想婚禮。從預算追蹤到賓客管理，我們陪你走過每一個動人時刻。"
          }
        }
      }
    },
