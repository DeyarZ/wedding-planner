    "The plan is already built. You only ever see the handful of things that matter this week." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخطة جاهزة بالفعل. ولا ترى سوى الأمور القليلة التي تهمّ هذا الأسبوع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plán je už hotový. Vždycky vidíte jen tu hrstku věcí, na kterých tento týden záleží."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planen er allerede bygget. I ser kun de få ting, der betyder noget i denne uge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Plan steht schon. Ihr seht immer nur die paar Dinge, die diese Woche zählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plan ya está hecho. Solo veis las pocas cosas que de verdad importan esta semana."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plaan on juba valmis. Sa näed alati vaid seda käputäit asju, mis sel nädalal tähtsad on."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suunnitelma on jo valmis. Näet vain ne muutamat asiat, joilla on merkitystä tällä viikolla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plan est déjà construit. Vous ne voyez que les quelques points qui comptent cette semaine."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan je već složen. Vi vidite samo onih nekoliko stvari koje su važne ovaj tjedan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A terv már készen áll. Mindig csak azt a néhány dolgot látod, ami ezen a héten számít."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áætlunin er þegar tilbúin. Þú sérð aldrei nema þau fáu atriði sem skipta máli í þessari viku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il piano è già pronto. Vedrete sempre e solo le poche cose che contano questa settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プランはすでにできあがっています。表示されるのは、今週大切なわずかなことだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플랜은 이미 완성돼 있어요. 두 분은 이번 주에 중요한 몇 가지만 보면 돼요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plāns jau ir izveidots. Tu redzi tikai tās dažas lietas, kas svarīgas šonedēļ."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planen er allerede bygget. Dere ser bare de få tingene som betyr noe denne uken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het plan staat al klaar. Je ziet alleen de handvol dingen die deze week belangrijk zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan jest już gotowy. Widzicie tylko tę garstkę rzeczy, które liczą się w tym tygodniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plano já está pronto. Você só vê as poucas coisas que importam nesta semana."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planul e deja construit. Tu vezi doar cele câteva lucruri care contează săptămâna aceasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "План уже собран. Вы видите только те несколько дел, которые важны на этой неделе."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plán je už hotový. Vždy vidíte len tú hŕstku vecí, na ktorých záleží tento týždeň."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Načrt je že sestavljen. Vidita samo tisto peščico stvari, ki šteje ta teden."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planen är redan byggd. Du ser bara den handfull saker som spelar roll den här veckan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แผนถูกสร้างไว้เรียบร้อยแล้ว คุณจะเห็นแค่ไม่กี่อย่างที่สำคัญในสัปดาห์นี้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan zaten hazır. Siz yalnızca bu hafta önemli olan birkaç şeyi görürsünüz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "План уже складено. Ви бачите лише ті кілька справ, які важливі цього тижня."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kế hoạch đã được dựng sẵn. Bạn chỉ luôn nhìn thấy vài việc thật sự quan trọng của tuần này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计划已经排好了。你们每次只会看到这一周真正要紧的那几件事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計畫已經幫你排好了。你每次只會看到這週真正重要的那幾件事。"
          }
        }
      }
    },
