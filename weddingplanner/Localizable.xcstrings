    "We implement appropriate technical and organizational measures to protect your personal information against unauthorized access, alteration, disclosure, or destruction." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نطبّق تدابير تقنية وتنظيمية مناسبة لحماية معلوماتك الشخصية من الوصول أو التعديل أو الإفصاح أو الإتلاف غير المصرّح به."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zavádíme vhodná technická a organizační opatření, která chrání vaše osobní údaje před neoprávněným přístupem, změnou, zveřejněním nebo zničením."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi anvender passende tekniske og organisatoriske foranstaltninger for at beskytte dine personoplysninger mod uautoriseret adgang, ændring, videregivelse eller destruktion."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir treffen geeignete technische und organisatorische Maßnahmen, um deine Daten vor unbefugtem Zugriff, Änderung, Offenlegung oder Zerstörung zu schützen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicamos medidas técnicas y organizativas adecuadas para proteger tus datos frente a accesos, alteraciones o divulgaciones no autorizadas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakendame asjakohaseid tehnilisi ja korralduslikke meetmeid, et kaitsta sinu isikuandmeid volitamata juurdepääsu, muutmise, avalikustamise või hävitamise eest."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toteutamme asianmukaiset tekniset ja organisatoriset toimenpiteet suojataksemme henkilötietosi luvattomalta pääsyltä, muuttamiselta, luovuttamiselta tai tuhoamiselta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous appliquons des mesures techniques et organisationnelles appropriées pour protéger vos données contre tout accès, modification ou divulgation non autorisés."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provodimo odgovarajuće tehničke i organizacijske mjere kako bismo zaštitili vaše osobne podatke od neovlaštenog pristupa, izmjene, otkrivanja ili uništenja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megfelelő technikai és szervezési intézkedéseket alkalmazunk, hogy megvédjük a személyes adataidat a jogosulatlan hozzáféréstől, módosítástól, nyilvánosságra hozataltól vagy megsemmisítéstől."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Við beitum viðeigandi tæknilegum og skipulagslegum ráðstöfunum til að vernda persónuupplýsingar þínar gegn óheimilum aðgangi, breytingum, birtingu eða eyðingu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adottiamo misure tecniche e organizzative adeguate per proteggere i tuoi dati da accessi, modifiche o divulgazioni non autorizzati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当社は、お客様の個人情報を不正なアクセス、改変、開示、破壊から保護するため、適切な技術的および組織的措置を講じています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당사는 이용자의 개인정보를 무단 접근, 변경, 공개 또는 파기로부터 보호하기 위해 적절한 기술적·관리적 조치를 시행합니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mēs īstenojam atbilstošus tehniskus un organizatoriskus pasākumus, lai aizsargātu tavu personisko informāciju pret nesankcionētu piekļuvi, izmainīšanu, izpaušanu vai iznīcināšanu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi iverksetter egnede tekniske og organisatoriske tiltak for å beskytte personopplysningene dine mot uautorisert tilgang, endring, utlevering eller ødeleggelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We nemen passende technische en organisatorische maatregelen om je persoonlijke gegevens te beschermen tegen ongeoorloofde toegang, wijziging, openbaarmaking of vernietiging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stosujemy odpowiednie środki techniczne i organizacyjne, aby chronić Twoje dane osobowe przed nieuprawnionym dostępem, zmianą, ujawnieniem lub zniszczeniem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adotamos medidas técnicas e organizacionais adequadas para proteger suas informações pessoais contra acesso, alteração, divulgação ou destruição não autorizados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicăm măsuri tehnice și organizatorice adecvate pentru a-ți proteja datele personale împotriva accesului neautorizat, a modificării, a divulgării sau a distrugerii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы принимаем необходимые технические и организационные меры, чтобы защитить вашу личную информацию от несанкционированного доступа, изменения, раскрытия или уничтожения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zavádzame primerané technické a organizačné opatrenia na ochranu vašich osobných údajov pred neoprávneným prístupom, zmenou, zverejnením alebo zničením."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvajamo ustrezne tehnične in organizacijske ukrepe za zaščito vaših osebnih podatkov pred nepooblaščenim dostopom, spreminjanjem, razkritjem ali uničenjem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi vidtar lämpliga tekniska och organisatoriska åtgärder för att skydda dina personuppgifter mot obehörig åtkomst, ändring, spridning eller förstörelse."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราใช้มาตรการทางเทคนิคและองค์กรที่เหมาะสมเพื่อปกป้องข้อมูลส่วนบุคคลของคุณจากการเข้าถึง แก้ไข เปิดเผย หรือทำลายโดยไม่ได้รับอนุญาต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişisel bilgilerinizi yetkisiz erişime, değiştirilmeye, ifşa edilmeye veya yok edilmeye karşı korumak için uygun teknik ve idari önlemleri alıyoruz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми вживаємо належних технічних та організаційних заходів, щоб захистити вашу особисту інформацію від несанкціонованого доступу, зміни, розкриття чи знищення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi áp dụng các biện pháp kỹ thuật và tổ chức phù hợp để bảo vệ thông tin cá nhân của bạn khỏi việc truy cập, thay đổi, tiết lộ hoặc phá hủy trái phép."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们采取适当的技术和组织措施，保护您的个人信息不被未经授权地访问、更改、披露或销毁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們採取適當的技術與組織措施，保護你的個人資訊，避免遭到未經授權的存取、變更、揭露或破壞。"
          }
        }
      }
    },
    "We use the information we collect to provide, maintain, and improve our services, process transactions, send you technical notices and support messages, and communicate with you about products, services, and events." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نستخدم المعلومات التي نجمعها لتقديم خدماتنا وصيانتها وتحسينها، ومعالجة المعاملات، وإرسال الإشعارات التقنية ورسائل الدعم إليك، والتواصل معك بشأن المنتجات والخدمات والفعاليات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shromážděné informace používáme k poskytování, udržování a zlepšování našich služeb, ke zpracování transakcí, k zasílání technických oznámení a zpráv podpory a ke komunikaci o produktech, službách a událostech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi bruger de oplysninger, vi indsamler, til at levere, vedligeholde og forbedre vores tjenester, behandle transaktioner, sende dig tekniske meddelelser og supportbeskeder samt kommunikere med dig om produkter, tjenester og begivenheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir nutzen deine Daten, um unsere Dienste bereitzustellen, zu verbessern, Transaktionen abzuwickeln, technische Hinweise und Support zu senden und über Produkte und Angebote zu informieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usamos la información para prestar y mejorar el servicio, procesar transacciones, enviarte avisos técnicos y soporte, y comunicarte sobre productos y eventos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasutame kogutud teavet oma teenuste pakkumiseks, hooldamiseks ja täiustamiseks, tehingute töötlemiseks, sulle tehniliste teadete ja tugisõnumite saatmiseks ning sinuga toodete, teenuste ja sündmuste teemal suhtlemiseks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytämme keräämiämme tietoja palveluidemme tarjoamiseen, ylläpitoon ja parantamiseen, maksutapahtumien käsittelyyn, teknisten ilmoitusten ja tukiviestien lähettämiseen sekä viestintään tuotteista, palveluista ja tapahtumista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous utilisons ces données pour fournir et améliorer nos services, traiter les transactions, envoyer des avis techniques et du support, et communiquer sur les produits et événements."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podatke koje prikupljamo koristimo za pružanje, održavanje i poboljšanje naših usluga, obradu transakcija, slanje tehničkih obavijesti i poruka podrške te za komunikaciju s vama o proizvodima, uslugama i događajima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az összegyűjtött adatokat arra használjuk, hogy szolgáltatásainkat nyújtsuk, fenntartsuk és fejlesszük, tranzakciókat dolgozzunk fel, technikai értesítéseket és támogatási üzeneteket küldjünk, valamint termékekről, szolgáltatásokról és eseményekről tájékoztassunk."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Við notum upplýsingarnar sem við söfnum til að veita, viðhalda og bæta þjónustu okkar, vinna úr færslum, senda þér tæknilegar tilkynningar og þjónustuskilaboð og eiga samskipti við þig um vörur, þjónustu og viðburði."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usiamo le informazioni per fornire e migliorare i servizi, gestire le transazioni, inviarti avvisi tecnici e assistenza e comunicare su prodotti ed eventi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収集した情報は、サービスの提供・維持・改善、取引の処理、技術的なお知らせやサポートメッセージの送信、製品・サービス・イベントに関するご連絡のために利用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당사는 수집한 정보를 서비스 제공·유지·개선, 거래 처리, 기술 공지 및 지원 메시지 발송, 제품·서비스·이벤트 관련 안내에 사용합니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Savākto informāciju izmantojam, lai nodrošinātu, uzturētu un uzlabotu savus pakalpojumus, apstrādātu darījumus, sūtītu tehniskus paziņojumus un atbalsta ziņas, kā arī informētu tevi par produktiem, pakalpojumiem un notikumiem."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi bruker informasjonen vi samler inn til å levere, vedlikeholde og forbedre tjenestene våre, behandle transaksjoner, sende deg tekniske varsler og supportmeldinger, og kommunisere med deg om produkter, tjenester og arrangementer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We gebruiken de gegevens die we verzamelen om onze diensten te leveren, te onderhouden en te verbeteren, transacties te verwerken, je technische meldingen en supportberichten te sturen en met je te communiceren over producten, diensten en evenementen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zebrane informacje wykorzystujemy, aby świadczyć, utrzymywać i ulepszać nasze usługi, realizować transakcje, wysyłać powiadomienia techniczne i wiadomości wsparcia oraz informować Cię o produktach, usługach i wydarzeniach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usamos as informações que coletamos para fornecer, manter e melhorar nossos serviços, processar transações, enviar avisos técnicos e mensagens de suporte e nos comunicar com você sobre produtos, serviços e eventos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosim informațiile colectate pentru a furniza, a menține și a îmbunătăți serviciile noastre, pentru a procesa tranzacții, pentru a-ți trimite notificări tehnice și mesaje de asistență și pentru a comunica cu tine despre produse, servicii și evenimente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы используем собранную информацию, чтобы предоставлять, поддерживать и улучшать наши сервисы, обрабатывать операции, отправлять вам технические уведомления и сообщения поддержки, а также рассказывать о продуктах, сервисах и событиях."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zhromaždené údaje používame na poskytovanie, udržiavanie a zlepšovanie našich služieb, spracovanie transakcií, zasielanie technických oznámení a správ podpory a na komunikáciu s vami o produktoch, službách a udalostiach."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbrane podatke uporabljamo za zagotavljanje, vzdrževanje in izboljševanje naših storitev, obdelavo transakcij, pošiljanje tehničnih obvestil in sporočil podpore ter za komuniciranje z vami o izdelkih, storitvah in dogodkih."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi använder de uppgifter vi samlar in för att tillhandahålla, underhålla och förbättra våra tjänster, hantera transaktioner, skicka tekniska meddelanden och supportmeddelanden till dig samt kommunicera med dig om produkter, tjänster och evenemang."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราใช้ข้อมูลที่เก็บรวบรวมเพื่อให้บริการ ดูแล และปรับปรุงบริการของเรา ดำเนินการธุรกรรม ส่งประกาศทางเทคนิคและข้อความช่วยเหลือ รวมถึงติดต่อคุณเกี่ยวกับผลิตภัณฑ์ บริการ และกิจกรรมต่าง ๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topladığımız bilgileri hizmetlerimizi sunmak, sürdürmek ve geliştirmek; işlemleri gerçekleştirmek; size teknik bildirimler ve destek mesajları göndermek; ürünler, hizmetler ve etkinlikler hakkında sizinle iletişim kurmak için kullanıyoruz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми використовуємо зібрану інформацію, щоб надавати, підтримувати й покращувати наші послуги, обробляти транзакції, надсилати вам технічні повідомлення та повідомлення підтримки, а також спілкуватися з вами про продукти, послуги й події."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi sử dụng thông tin thu thập được để cung cấp, duy trì và cải thiện dịch vụ, xử lý giao dịch, gửi cho bạn các thông báo kỹ thuật và tin nhắn hỗ trợ, cũng như trao đổi với bạn về sản phẩm, dịch vụ và sự kiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们使用所收集的信息来提供、维护和改进我们的服务，处理交易，向您发送技术通知和支持消息，并就产品、服务和活动与您沟通。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們使用所蒐集的資訊來提供、維護與改善服務，處理交易，寄送技術通知與客服訊息，並與你溝通產品、服務和活動相關事宜。"
          }
        }
      }
    },
    "We use tracking only to personalize your planning and keep this app free. You decide on the next screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نستخدم التتبع فقط لتخصيص تخطيطك وإبقاء هذا التطبيق مجانيًا. والقرار لك في الشاشة التالية."
