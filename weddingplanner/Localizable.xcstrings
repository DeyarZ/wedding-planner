    "Everlens turns every guest into a photographer. One QR code on the table — no app to download, no sign-up." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everlens macht jeden Gast zum Fotografen. Ein QR-Code auf dem Tisch – keine App zum Herunterladen, keine Registrierung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everlens convierte a cada invitado en fotógrafo. Un código QR en la mesa: sin descargar apps, sin registrarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everlens fait de chaque invité un photographe. Un QR code sur la table : aucune appli à télécharger, aucune inscription."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everlens trasforma ogni invitato in un fotografo. Un codice QR sul tavolo: nessuna app da scaricare, nessuna registrazione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everlens maakt van elke gast een fotograaf. Eén QR-code op tafel – geen app downloaden, geen account nodig."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Everlens transforma cada convidado em fotógrafo. Um QR code na mesa: sem baixar app, sem cadastro."
          }
        }
      }
    },
