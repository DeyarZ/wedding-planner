    "Add everyone you want there — you can refine it any time" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف كل من تريد حضوره — يمكنك التعديل في أي وقت"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
