    "Track your budget, manage vendors, organize guests, and timeline every detail. Our smart features adapt to your style and stress levels." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تابع ميزانيتك، وأدر مورديك، ونظّم ضيوفك، وجدول كل تفصيل. تتكيف ميزاتنا الذكية مع أسلوبك ومستوى توترك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledujte rozpočet, spravujte dodavatele, organizujte hosty a naplánujte každý detail. Naše chytré funkce se přizpůsobí vašemu stylu i míře stresu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold styr på budgettet, håndtér leverandører, organisér gæsterne og sæt hver detalje på tidsplanen. Vores smarte funktioner tilpasser sig jeres stil og stressniveau."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte dein Budget im Blick, verwalte Dienstleister, organisiere Gäste und plane jedes Detail. Unsere smarten Funktionen passen sich dir an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla tu presupuesto, gestiona proveedores, organiza invitados y planifica cada detalle. Funciones inteligentes que se adaptan a ti."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jälgi eelarvet, halda teenusepakkujaid, korralda külalisi ja pane iga detail ajakavva. Meie nutikad funktsioonid kohanduvad sinu stiili ja stressitasemega."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraa budjettiasi, hallitse palveluntarjoajia, järjestä vieraat ja aikatauluta jokainen yksityiskohta. Älykkäät ominaisuutemme mukautuvat tyyliisi ja stressitasoosi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez votre budget, gérez les prestataires, organisez les invités et planifiez chaque détail. Des fonctions intelligentes qui s'adaptent à vous."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratite proračun, upravljajte dobavljačima, organizirajte goste i posložite svaki detalj u vremenski plan. Naše se pametne značajke prilagođavaju vašem stilu i razini stresa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kövesd a költségvetésed, kezeld a szolgáltatókat, szervezd a vendégeket, és ütemezd be minden részletet. Okos funkcióink alkalmazkodnak a stílusodhoz és a stresszszintedhez."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fylgstu með fjárhagsáætluninni, haltu utan um þjónustuaðila, raðaðu gestunum og tímasettu hvert smáatriði. Snjallir eiginleikar okkar aðlagast stílnum þínum og stressinu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni d'occhio il budget, gestisci i fornitori, organizza gli ospiti e pianifica ogni dettaglio. Funzioni intelligenti che si adattano a te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予算を管理し、業者をまとめ、ゲストを整理して、細部までタイムラインに落とし込めます。かしこい機能が、おふたりのスタイルと気持ちの余裕に合わせて寄り添います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예산을 관리하고, 업체를 챙기고, 하객을 정리하고, 모든 디테일을 타임라인에 담으세요. 똑똑한 기능이 두 분의 스타일과 컨디션에 맞춰 움직여요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seko līdzi budžetam, pārvaldi pakalpojumu sniedzējus, sakārto viesus un ieplāno katru detaļu. Mūsu gudrās funkcijas pielāgojas tavam stilam un stresa līmenim."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg budsjettet, håndter leverandører, organiser gjestene og legg hver detalj inn på tidslinjen. De smarte funksjonene våre tilpasser seg stilen og stressnivået deres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je budget bij, beheer leveranciers, organiseer gasten en zet elk detail in de tijdlijn. Onze slimme functies passen zich aan jullie stijl en stressniveau aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śledźcie budżet, zarządzajcie usługodawcami, ogarnijcie gości i wpiszcie każdy szczegół w harmonogram. Nasze inteligentne funkcje dopasują się do Waszego stylu i poziomu stresu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe o orçamento, cuide dos fornecedores, organize os convidados e coloque cada detalhe no cronograma. Nossas funcionalidades inteligentes se adaptam ao seu estilo e ao seu nível de estresse."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urmărește-ți bugetul, gestionează furnizorii, organizează invitații și pune fiecare detaliu pe cronologie. Funcțiile noastre inteligente se adaptează stilului și nivelului tău de stres."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следите за бюджетом, ведите подрядчиков, организуйте гостей и расписывайте по времени каждую деталь. Умные функции подстраиваются под ваш стиль и уровень стресса."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledujte rozpočet, spravujte dodávateľov, organizujte hostí a naplánujte každý detail. Naše inteligentné funkcie sa prispôsobia vášmu štýlu aj miere stresu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremljajta proračun, upravljajta ponudnike, urejajta goste in v časovnico umestita vsako podrobnost. Naše pametne funkcije se prilagodijo vajinemu slogu in ravni stresa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll koll på budgeten, hantera leverantörer, organisera gästerna och tidsätt varje detalj. Våra smarta funktioner anpassar sig efter din stil och din stressnivå."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ติดตามงบประมาณ จัดการผู้ให้บริการ จัดระเบียบแขก และวางไทม์ไลน์ทุกรายละเอียด ฟีเจอร์อัจฉริยะของเราปรับตามสไตล์และระดับความเครียดของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bütçenizi takip edin, tedarikçileri yönetin, misafirleri düzenleyin ve her detayı zaman çizelgesine yerleştirin. Akıllı özelliklerimiz tarzınıza ve stres seviyenize uyum sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контролюйте бюджет, ведіть підрядників, організовуйте гостей і вкладайте кожну деталь у графік. Наші розумні функції підлаштовуються під ваш стиль і рівень стресу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo dõi ngân sách, quản lý nhà cung cấp, sắp xếp khách mời và lên lịch trình cho từng chi tiết. Các tính năng thông minh của chúng tôi thích ứng với phong cách và mức độ căng thẳng của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追踪预算、管理供应商、整理宾客，把每个细节排进时间轴。智能功能会随你们的风格和压力状态自动调整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追蹤預算、管理廠商、整理賓客，把每個細節排進婚禮流程。我們的智慧功能會配合你的風格和壓力狀態調整。"
          }
        }
      }
    },
