        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puolimatkassa! Nyt on aika lyödä lukkoon ne isot päätökset"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À mi-chemin ! Il est temps de trancher les grandes décisions"
          }
