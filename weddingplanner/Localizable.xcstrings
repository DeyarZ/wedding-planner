    },
    "The free plan tracks 3 vendors. Premium tracks your whole dream team, contracts and payments included." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخطة المجانية تتابع 3 موردين. أما النسخة المميزة فتتابع فريق أحلامك كاملًا، بعقوده ودفعاته."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plán zdarma sleduje 3 dodavatele. Premium sleduje celý váš tým snů včetně smluv a plateb."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den gratis plan holder styr på 3 leverandører. Premium holder styr på hele jeres drømmehold — kontrakter og betalinger inklusive."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der kostenlose Plan verwaltet 3 Dienstleister. Premium verwaltet euer ganzes Dreamteam – mit Verträgen und Zahlungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
