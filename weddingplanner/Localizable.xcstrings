    "Rise and shine! Let's tackle today's wedding tasks together ✨" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استيقظي بإشراق! لننجز مهام الزفاف اليوم معًا ✨"
