        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите от двух до четырёх. Мы сместим бюджет в их сторону."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
