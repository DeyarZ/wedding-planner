    "Only 1 day left! Continue planning your dream wedding with full access to all features 💍" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بقي يوم واحد فقط! واصل التخطيط لزفاف أحلامك بوصول كامل إلى كل الميزات 💍"
          }
        },
        "cs" : {
          "stringUnit" : {
