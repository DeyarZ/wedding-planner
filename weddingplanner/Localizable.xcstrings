    "Trust your vendors,\nthey want your day to be beautiful too" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثق بمورديك،\nفهم أيضًا يريدون ليومك أن يكون جميلًا"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Věřte svým dodavatelům,\ni oni chtějí, aby byl váš den krásný"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stol på jeres leverandører,\nde vil også have, at jeres dag bliver smuk"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertraue deinen Dienstleistern,\nauch sie wollen einen schönen Tag"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confía en tus proveedores,\nellos también quieren un día precioso"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usalda oma teenusepakkujaid,\nka nemad soovivad, et sinu päev oleks kaunis"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luota palveluntarjoajiisi,\nhekin haluavat päivästänne kauniin"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites confiance à vos prestataires,\neux aussi veulent un beau jour"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vjerujte svojim dobavljačima,\ni oni žele da vaš dan bude prekrasan"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bízz a szolgáltatóidban,\nők is azt akarják, hogy szép legyen a napod"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
