    "Our app may contain links to third-party websites or services. We are not responsible for the privacy practices of these third parties. We encourage you to read their privacy policies." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يحتوي تطبيقنا على روابط لمواقع أو خدمات تابعة لجهات خارجية. ونحن لسنا مسؤولين عن ممارسات الخصوصية لدى هذه الجهات. ونشجعك على قراءة سياسات الخصوصية الخاصة بها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naše aplikace může obsahovat odkazy na weby nebo služby třetích stran. Za jejich postupy při ochraně soukromí neneseme odpovědnost. Doporučujeme vám přečíst si jejich zásady ochrany osobních údajů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vores app kan indeholde links til tredjeparters websteder eller tjenester. Vi er ikke ansvarlige for disse tredjeparters behandling af persondata. Vi opfordrer dig til at læse deres privatlivspolitikker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsere App kann Links zu Drittanbietern enthalten. Für deren Datenschutz sind wir nicht verantwortlich. Bitte lies deren Datenschutzerklärungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuestra app puede tener enlaces a terceros. No somos responsables de su privacidad. Te recomendamos leer sus políticas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meie rakendus võib sisaldada linke kolmandate osapoolte veebisaitidele või teenustele. Me ei vastuta nende kolmandate osapoolte privaatsustavade eest. Soovitame nende privaatsuspoliitikad läbi lugeda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovelluksemme voi sisältää linkkejä kolmansien osapuolten verkkosivustoille tai palveluihin. Emme vastaa näiden kolmansien osapuolten tietosuojakäytännöistä. Suosittelemme lukemaan heidän tietosuojakäytäntönsä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notre app peut contenir des liens vers des tiers. Nous ne sommes pas responsables de leur confidentialité. Lisez leurs politiques."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naša aplikacija može sadržavati poveznice na web-stranice ili usluge trećih strana. Nismo odgovorni za njihove prakse zaštite privatnosti. Preporučujemo vam da pročitate njihova pravila privatnosti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alkalmazásunk harmadik felek weboldalaira vagy szolgáltatásaira mutató hivatkozásokat tartalmazhat. Nem vállalunk felelősséget ezeknek a harmadik feleknek az adatvédelmi gyakorlatáért. Javasoljuk, hogy olvasd el az adatvédelmi tájékoztatóikat."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appið okkar getur innihaldið tengla á vefsíður eða þjónustur þriðja aðila. Við berum ekki ábyrgð á persónuverndarháttum þessara þriðju aðila. Við hvetjum þig til að lesa persónuverndarstefnur þeirra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nostra app può contenere link a terze parti. Non siamo responsabili della loro privacy. Ti invitiamo a leggere le loro informative."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本アプリには第三者のウェブサイトやサービスへのリンクが含まれる場合があります。当社はこれら第三者のプライバシーに関する取り扱いについて責任を負いません。各社のプライバシーポリシーをご確認いただくことをおすすめします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본 앱에는 제3자 웹사이트 또는 서비스로 연결되는 링크가 포함될 수 있습니다. 당사는 이러한 제3자의 개인정보 처리 방식에 대해 책임지지 않습니다. 해당 제3자의 개인정보 처리방침을 확인하시기 바랍니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mūsu lietotnē var būt saites uz trešo pušu vietnēm vai pakalpojumiem. Mēs neatbildam par šo trešo pušu privātuma praksi. Aicinām iepazīties ar viņu privātuma politikām."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen vår kan inneholde lenker til nettsteder eller tjenester fra tredjeparter. Vi er ikke ansvarlige for personvernpraksisen til disse tredjepartene. Vi oppfordrer deg til å lese personvernerklæringene deres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onze app kan links bevatten naar websites of diensten van derden. Wij zijn niet verantwoordelijk voor de privacypraktijken van deze derden. We raden je aan hun privacybeleid te lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasza aplikacja może zawierać odnośniki do stron lub usług podmiotów trzecich. Nie odpowiadamy za praktyki prywatności tych podmiotów. Zachęcamy do zapoznania się z ich politykami prywatności."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nosso app pode conter links para sites ou serviços de terceiros. Não somos responsáveis pelas práticas de privacidade desses terceiros. Recomendamos que você leia as políticas de privacidade deles."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicația noastră poate conține linkuri către site-uri sau servicii ale terților. Nu suntem responsabili pentru practicile de confidențialitate ale acestor terți. Te încurajăm să le citești politicile de confidențialitate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наше приложение может содержать ссылки на сторонние сайты и сервисы. Мы не несём ответственности за их подход к конфиденциальности. Рекомендуем ознакомиться с их политиками конфиденциальности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naša aplikácia môže obsahovať odkazy na webové stránky alebo služby tretích strán. Za to, ako tieto tretie strany narábajú so súkromím, nenesieme zodpovednosť. Odporúčame vám prečítať si ich zásady ochrany osobných údajov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naša aplikacija lahko vsebuje povezave do spletnih mest ali storitev tretjih oseb. Za njihove prakse varovanja zasebnosti nismo odgovorni. Priporočamo, da preberete njihove politike zasebnosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vår app kan innehålla länkar till webbplatser eller tjänster från tredje part. Vi ansvarar inte för dessa tredje parters hantering av personuppgifter. Vi rekommenderar att du läser deras integritetspolicyer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปของเราอาจมีลิงก์ไปยังเว็บไซต์หรือบริการของบุคคลที่สาม เราไม่รับผิดชอบต่อแนวปฏิบัติด้านความเป็นส่วนตัวของบุคคลที่สามเหล่านั้น เราขอแนะนำให้คุณอ่านนโยบายความเป็นส่วนตัวของพวกเขา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamamız üçüncü taraf web sitelerine veya hizmetlerine bağlantılar içerebilir. Bu üçüncü tarafların gizlilik uygulamalarından sorumlu değiliz. Onların gizlilik politikalarını okumanızı öneririz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наш застосунок може містити посилання на сторонні вебсайти чи сервіси. Ми не відповідаємо за їхні практики конфіденційності. Радимо ознайомитися з їхніми політиками конфіденційності."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng của chúng tôi có thể chứa liên kết đến các trang web hoặc dịch vụ của bên thứ ba. Chúng tôi không chịu trách nhiệm về cách các bên thứ ba này xử lý quyền riêng tư. Chúng tôi khuyến khích bạn đọc chính sách quyền riêng tư của họ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用可能包含指向第三方网站或服务的链接。我们不对这些第三方的隐私做法负责。建议您阅读他们的隐私政策。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本應用程式可能包含第三方網站或服務的連結。我們不對這些第三方的隱私權作法負責，建議你自行閱讀他們的隱私權政策。"
          }
        }
      }
    },
