    "The app is provided 'as is' without any warranties. We shall not be liable for any damages arising from the use of this app. Your use of the app is at your own risk." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُقدَّم التطبيق «كما هو» دون أي ضمانات. ولن نكون مسؤولين عن أي أضرار تنشأ عن استخدام هذا التطبيق. واستخدامك للتطبيق يكون على مسؤوليتك الخاصة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace je poskytována „tak, jak je“, bez jakýchkoli záruk. Neneseme odpovědnost za žádné škody vzniklé používáním této aplikace. Aplikaci používáte na vlastní riziko."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen leveres 'som den er' uden nogen form for garanti. Vi er ikke ansvarlige for skader, der opstår som følge af brugen af appen. Brugen af appen sker på eget ansvar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App wird ohne Gewähr „wie besehen“ bereitgestellt. Wir haften nicht für Schäden aus der Nutzung. Die Nutzung erfolgt auf eigenes Risiko."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app se ofrece 'tal cual' sin garantías. No somos responsables de daños por su uso. El uso es bajo tu propio riesgo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakendus antakse „nagu on“ põhimõttel ilma igasuguste garantiideta. Me ei vastuta ühegi kahju eest, mis tuleneb selle rakenduse kasutamisest. Kasutad rakendust omal vastutusel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovellus tarjotaan sellaisenaan ilman takuita. Emme vastaa mistään sovelluksen käytöstä aiheutuvista vahingoista. Käytät sovellusta omalla vastuullasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app est fournie « telle quelle » sans garantie. Nous ne sommes pas responsables des dommages liés à son usage. L'utilisation se fait à vos risques."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija se pruža 'kakva jest', bez ikakvih jamstava. Ne odgovaramo ni za kakvu štetu nastalu korištenjem ove aplikacije. Aplikaciju koristite na vlastitu odgovornost."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazást „ahogy van” állapotban biztosítjuk, mindenféle garancia nélkül. Nem vállalunk felelősséget az alkalmazás használatából eredő károkért. Az alkalmazást saját felelősségedre használod."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appið er veitt „eins og það er“ án nokkurra ábyrgða. Við berum ekki ábyrgð á tjóni sem hlýst af notkun appsins. Notkun appsins er á þína eigin ábyrgð."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app è fornita 'così com'è' senza garanzie. Non siamo responsabili per danni derivanti dall'uso. L'uso è a tuo rischio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本アプリは、いかなる保証もなく「現状有姿」で提供されます。当社は本アプリの使用から生じるいかなる損害についても責任を負いません。本アプリのご利用はお客様ご自身の責任において行ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본 앱은 어떠한 보증도 없이 '있는 그대로' 제공됩니다. 당사는 본 앱의 사용으로 발생하는 어떠한 손해에 대해서도 책임지지 않습니다. 앱 사용에 따른 책임은 이용자 본인에게 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lietotne tiek nodrošināta tāda, kāda tā ir, bez jebkādām garantijām. Mēs neatbildam par zaudējumiem, kas rodas, lietojot šo lietotni. Tu lieto lietotni uz savu atbildību."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen leveres «som den er» uten noen form for garantier. Vi er ikke ansvarlige for skader som oppstår ved bruk av appen. All bruk av appen skjer på eget ansvar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app wordt geleverd 'zoals hij is', zonder enige garantie. Wij zijn niet aansprakelijk voor schade die voortvloeit uit het gebruik van deze app. Je gebruikt de app op eigen risico."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja jest udostępniana „w stanie, w jakim jest”, bez jakichkolwiek gwarancji. Nie ponosimy odpowiedzialności za szkody wynikające z korzystania z tej aplikacji. Korzystasz z niej na własne ryzyko."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app é fornecido 'como está', sem garantias. Não nos responsabilizamos por quaisquer danos decorrentes do uso deste app. O uso do app é por sua conta e risco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicația este furnizată „ca atare”, fără nicio garanție. Nu răspundem pentru niciun fel de daune rezultate din utilizarea acestei aplicații. Folosești aplicația pe propriul risc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение предоставляется «как есть», без каких-либо гарантий. Мы не несём ответственности за любой ущерб, возникший в результате использования приложения. Вы используете приложение на свой страх и риск."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikácia sa poskytuje „tak, ako je“, bez akýchkoľvek záruk. Nenesieme zodpovednosť za žiadne škody vzniknuté používaním tejto aplikácie. Aplikáciu používate na vlastné riziko."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija je na voljo »takšna, kot je«, brez kakršnih koli jamstev. Ne odgovarjamo za nobeno škodo, ki bi nastala zaradi uporabe te aplikacije. Aplikacijo uporabljate na lastno odgovornost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen tillhandahålls i befintligt skick utan några garantier. Vi ansvarar inte för skador som uppstår vid användning av appen. Du använder appen på egen risk."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปนี้ให้บริการ 'ตามสภาพ' โดยไม่มีการรับประกันใด ๆ เราจะไม่รับผิดชอบต่อความเสียหายใด ๆ ที่เกิดจากการใช้งานแอปนี้ การใช้งานแอปถือเป็นความเสี่ยงของคุณเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama, hiçbir garanti verilmeksizin 'olduğu gibi' sunulur. Bu uygulamanın kullanımından doğan hiçbir zarardan sorumlu değiliz. Uygulamayı kullanmanın riski size aittir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосунок надається «як є», без жодних гарантій. Ми не несемо відповідальності за будь-які збитки, спричинені використанням цього застосунку. Ви користуєтеся застосунком на власний ризик."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng được cung cấp 'nguyên trạng' mà không kèm bất kỳ bảo đảm nào. Chúng tôi không chịu trách nhiệm cho bất kỳ thiệt hại nào phát sinh từ việc sử dụng ứng dụng này. Bạn tự chịu rủi ro khi sử dụng ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用按「现状」提供，不作任何担保。我们不对因使用本应用而产生的任何损害承担责任。您使用本应用的风险由您自行承担。"
          }
