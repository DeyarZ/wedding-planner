    "Every last cost lands in one of 12 categories, so you always know what is left before you commit to anything." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل تكلفة تُدرج ضمن واحدة من 12 فئة، لتعرف دائمًا ما تبقّى قبل أن تلتزم بأي شيء."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý poslední náklad spadne do jedné z 12 kategorií, takže vždycky víte, kolik vám zbývá, než se k něčemu zavážete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver eneste udgift lander i én af 12 kategorier, så I altid ved, hvad der er tilbage, før I siger ja til noget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Ausgabe landet in einer von 12 Kategorien — so wisst ihr immer, was noch übrig ist, bevor ihr zusagt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta el último gasto entra en una de las 12 categorías, así siempre sabéis cuánto os queda antes de comprometeros con nada."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga viimanegi kulu läheb ühte 12 kategooriast, nii tead alati, kui palju on veel alles, enne kui millegagi lõplikult nõustud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen kulu päätyy yhteen 12 kategoriasta, joten tiedät aina, mitä on jäljellä ennen kuin sitoudut mihinkään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque dépense atterrit dans l'une des 12 catégories : vous savez toujours ce qu'il reste avant de vous engager."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki trošak, do zadnjega, završi u jednoj od 12 kategorija, pa uvijek znate koliko je ostalo prije nego što se na nešto obvežete."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
