    "Only then does anything get charged — and you can cancel before that at any point." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندها فقط يتم أي خصم — ويمكنك الإلغاء قبل ذلك في أي وقت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teprve pak se něco strhne — a do té doby můžete kdykoli zrušit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Først derefter bliver der trukket noget — og indtil da kan du opsige når som helst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
