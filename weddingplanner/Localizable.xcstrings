        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を持参して — お花は言葉より見せるほうが伝わります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진을 가져가세요 — 꽃은 말로 하는 것보다 보여주는 게 쉬워요"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paņem līdzi bildes — ziedus ir vieglāk parādīt nekā aprakstīt"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta med bilder – blomster er lettere å vise enn å beskrive"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem foto's mee — bloemen laat je makkelijker zien dan dat je ze beschrijft"
