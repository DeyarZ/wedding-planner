    "Let's review and adjust – we've got this together" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لنراجع ونعدّل – سننجح في هذا معًا"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojďme to projít a doladit – zvládneme to spolu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad os se det igennem og justere – vi klarer det sammen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass uns prüfen und anpassen – das schaffen wir gemeinsam"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisemos y ajustemos: lo logramos juntos"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaatame üle ja kohendame – koos saame hakkama"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käydään läpi ja säädetään – hoidetaan tämä yhdessä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revoyons et ajustons – on y arrive ensemble"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregledajmo i prilagodimo – zajedno to možemo"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nézzük át és igazítsuk ki – együtt menni fog"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förum yfir og stillum af – við gerum þetta saman"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivediamo e aggiustiamo – ce la facciamo insieme"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見直して調整しましょう – ふたりなら大丈夫です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "함께 살펴보고 조정해요 – 우리라면 할 수 있어요"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārskatīsim un pielāgosim — kopā mēs to paveiksim"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La oss se over og justere – dette klarer vi sammen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even kijken en bijsturen – samen krijgen we dit voor elkaar"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejrzyjmy i dopasujmy – razem damy radę"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vamos revisar e ajustar – estamos juntos nessa"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai să revedem și să ajustăm – ne descurcăm împreună"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Давайте посмотрим и подправим — вместе справимся"
