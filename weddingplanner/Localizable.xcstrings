          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo repartiremos entre las doce categorías que tiene una boda de verdad y controlaremos cada presupuesto y cada pago, para que siempre sepáis cuánto os queda."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaotame selle kaheteistkümne kategooria vahel, mis pulmadel tegelikult on, ja jälgime iga hinnapakkumist ning makset — nii tead alati, kui palju on alles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaamme sen niihin kahteentoista kategoriaan, joita häissä todella on, ja seuraamme jokaista tarjousta ja maksua sitä vasten — niin tiedät aina, mitä on jäljellä."
          }
        },
        "fr" : {
          "stringUnit" : {
