    "Twelve budget categories, split for you and tracked to the last payment." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اثنتا عشرة فئة للميزانية، موزّعة لك ومتابَعة حتى آخر دفعة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvanáct kategorií rozpočtu, rozdělených za vás a sledovaných do poslední platby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tolv budgetkategorier, fordelt for jer og fulgt til sidste betaling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwölf Budget-Kategorien, für euch aufgeteilt und bis zur letzten Zahlung verfolgt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doce categorías de presupuesto, repartidas por nosotros y controladas hasta el último pago."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaksteist eelarvekategooriat, sinu eest ära jaotatud ja jälgitud viimase makseni."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaksitoista budjettikategoriaa, jaettuna puolestasi ja seurattuna viimeistä maksua myöten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Douze catégories de budget, réparties pour vous et suivies jusqu'au dernier paiement."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvanaest kategorija proračuna, podijeljenih umjesto vas i praćenih do zadnjeg plaćanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tizenkét költségvetési kategória, helyetted felosztva és az utolsó fizetésig követve."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
