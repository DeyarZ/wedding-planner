        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokacija, grad ili samo ideja — što god imate."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy helyszín, egy város vagy csak egy ötlet — bármi, ami már megvan."
          }
        },
