          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar Premium vari eksportēt savus viesus un pakalpojumu sniedzējus, kad vien nepieciešams."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Premium kan du eksportere gjestene og leverandørene dine når du trenger det."
          }
