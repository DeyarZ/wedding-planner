    "Every vendor keeps its own quotes, contracts, payments and notes, so nothing gets lost in your inbox." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل مورّد يحتفظ بعروض أسعاره وعقوده ودفعاته وملاحظاته، فلا يضيع شيء في بريدك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý dodavatel má vlastní nabídky, smlouvy, platby a poznámky, takže se nic neztratí ve vaší e-mailové schránce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver leverandør har sine egne tilbud, kontrakter, betalinger og noter, så intet forsvinder i jeres indbakke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Dienstleister hat eigene Angebote, Verträge, Zahlungen und Notizen — nichts geht mehr im Postfach unter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada proveedor guarda sus propios presupuestos, contratos, pagos y notas, así no se pierde nada en el correo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga teenusepakkuja juures on tema enda hinnapakkumised, lepingud, maksed ja märkmed, nii ei kao miski sinu postkasti ära."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokaisella palveluntarjoajalla on omat tarjouksensa, sopimuksensa, maksunsa ja muistiinpanonsa, joten mikään ei huku sähköpostiisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque prestataire garde ses devis, contrats, paiements et notes : plus rien ne se perd dans votre boîte mail."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki dobavljač ima svoje ponude, ugovore, plaćanja i bilješke, pa se ništa ne izgubi u vašem inboxu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
