        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huomenta, kaunotar! Valmiina suunnittelemaan täydellistä päivääsi? 💕"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour ma belle ! Prête à préparer votre jour parfait ? 💕"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobro jutro, ljepotice! Spremni za planiranje savršenog dana? 💕"
