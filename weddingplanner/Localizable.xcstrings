    "Get gentle reminders for tasks, vendor appointments, and special milestones on your wedding journey" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احصل على تذكيرات لطيفة بالمهام ومواعيد الموردين والمحطات المميزة في رحلة زفافك"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostávejte jemná připomenutí k úkolům, schůzkám s dodavateli a důležitým milníkům na vaší svatební cestě"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få blide påmindelser om opgaver, aftaler med leverandører og særlige milepæle på vejen mod brylluppet"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhaltet sanfte Erinnerungen an Aufgaben, Termine mit Dienstleistern und besondere Meilensteine auf eurem Weg zur Hochzeit"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe recordatorios suaves de tareas, citas con proveedores y momentos especiales de vuestro camino hacia la boda"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saa õrnaid meeldetuletusi ülesannete, teenusepakkujatega kohtumiste ja eriliste verstapostide kohta sinu pulmateekonnal"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat lempeitä muistutuksia tehtävistä, palveluntarjoajien tapaamisista ja hääsuunnittelusi tärkeistä hetkistä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez des rappels tout en douceur pour vos tâches, vos rendez-vous avec les prestataires et les grandes étapes de votre parcours"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primajte nježne podsjetnike za zadatke, sastanke s dobavljačima i posebne trenutke na vašem putu do vjenčanja"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapj finom emlékeztetőket a feladatokról, a szolgáltatói időpontokról és az esküvői utad mérföldköveiről"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fáðu mildar áminningar um verkefni, fundi með þjónustuaðilum og sérstaka áfanga á brúðkaupsferðalaginu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi promemoria delicati per attività, appuntamenti con i fornitori e tappe speciali del vostro percorso verso il matrimonio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タスクや業者との打ち合わせ、大切な節目を、やさしくお知らせします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "할 일, 업체 미팅, 결혼 준비의 특별한 순간까지 부드럽게 알려드릴게요"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saņem maigus atgādinājumus par uzdevumiem, tikšanām ar pakalpojumu sniedzējiem un īpašiem pagrieziena punktiem jūsu kāzu ceļā"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få vennlige påminnelser om oppgaver, leverandøravtaler og viktige milepæler på veien mot bryllupet"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontvang vriendelijke herinneringen voor taken, afspraken met leveranciers en bijzondere mijlpalen op weg naar jullie bruiloft"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otrzymujcie delikatne przypomnienia o zadaniach, spotkaniach z usługodawcami i ważnych momentach na Waszej drodze do ślubu"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba lembretes gentis de tarefas, compromissos com fornecedores e marcos especiais da sua jornada até o casamento"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primiți mementouri blânde pentru sarcini, întâlniri cu furnizorii și momentele importante de pe drumul vostru spre nuntă"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получайте мягкие напоминания о задачах, встречах с подрядчиками и важных вехах вашего свадебного пути"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostávajte jemné pripomienky na úlohy, stretnutia s dodávateľmi a výnimočné míľniky na vašej svadobnej ceste"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prejemajta nežne opomnike za opravila, sestanke s ponudniki in posebne mejnike na vajini poročni poti"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få vänliga påminnelser om uppgifter, möten med leverantörer och särskilda milstolpar på vägen mot bröllopet"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รับการเตือนแบบนุ่มนวลสำหรับสิ่งที่ต้องทำ นัดหมายกับผู้ให้บริการ และหมุดหมายสำคัญตลอดเส้นทางงานแต่งงานของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görevler, tedarikçi randevuları ve düğün yolculuğunuzdaki özel dönüm noktaları için nazik hatırlatmalar alın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отримуйте делікатні нагадування про завдання, зустрічі з підрядниками та важливі віхи вашого весільного шляху"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận những lời nhắc nhẹ nhàng về công việc, lịch hẹn với nhà cung cấp và các cột mốc đặc biệt trên hành trình cưới của bạn"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任务、供应商约见和婚礼路上的重要节点前，收到温柔的提醒"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的婚禮旅程中，溫柔提醒你任務、廠商約訪和重要里程碑"
          }
        }
      }
    },
