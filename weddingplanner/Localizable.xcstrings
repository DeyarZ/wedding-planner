    "Design, proofread and print — allow time for a reprint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صمّم وراجع واطبع — واترك وقتًا لإعادة الطباعة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navrhněte, zkontrolujte a vytiskněte — počítejte s časem na dotisk"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Design, korrekturlæs og tryk — sæt tid af til et gentryk"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestalten, Korrektur lesen, drucken — plant Zeit für einen Nachdruck ein"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diseñad, revisad e imprimid; dejad margen por si hay que reimprimir"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kujunda, loe üle ja trüki — jäta aega ka kordustrükiks"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suunnittele, oikolue ja paina — varaa aikaa uusintapainokselle"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez, relisez et imprimez — prévoyez du temps pour une réimpression"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osmislite, lektorirajte i otisnite — ostavite vremena za ponovni tisak"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tervezd meg, olvasd át, nyomtasd ki — hagyj időt egy újranyomásra"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hannaðu, prófarkalestu og prentaðu — gefðu svigrúm fyrir endurprentun"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafica, revisione e stampa: lasciate margine per una ristampa"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デザインして、校正して、印刷 — 刷り直しの時間も見ておきましょう"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디자인하고 교정한 뒤 인쇄하세요 — 재인쇄 시간도 여유 있게"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izstrādā, pārlasi un izdrukā — atvēli laiku arī atkārtotai drukai"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Design, korrekturles og trykk – sett av tid til en ny runde"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontwerpen, nalezen en drukken — houd tijd over voor een herdruk"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaprojektujcie, sprawdźcie i wydrukujcie — zostawcie czas na dodruk"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie, revise e imprima — deixe tempo para uma reimpressão"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creează, corectează și tipărește — lasă timp pentru o retipărire"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте макет, вычитайте и напечатайте — заложите время на перепечатку"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navrhnite, skontrolujte a vytlačte — nechajte si čas na dotlač"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oblikujta, preglejta in natisnita – pustita si čas za ponatis"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Designa, korrekturläs och tryck – ha marginal för en omtryckning"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ออกแบบ ตรวจทาน แล้วสั่งพิมพ์ — เผื่อเวลาไว้สำหรับพิมพ์ใหม่ด้วย"
