          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni fornitore ha i suoi preventivi, contratti, pagamenti e note, così non si perde più nulla nella posta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
