            "value" : "Dobro jutro! Svaki vas korak približava vašem 'Da' 💍"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jó reggelt! Minden lépés közelebb visz az igenhez 💍"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Góðan daginn! Hvert skref færir þig nær stóra „já-inu“ 💍"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buongiorno! Ogni passo ti avvicina al sì 💍"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おはようございます！一歩ずつ「誓いの日」に近づいていますね 💍"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좋은 아침이에요! 한 걸음씩 결혼식에 가까워지고 있어요 💍"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Labrīt! Katrs solis tuvina tevi tavam „Jā” 💍"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "God morgen! Hvert steg bringer deg nærmere ja-ordet 💍"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goedemorgen! Elke stap brengt je dichter bij het jawoord 💍"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzień dobry! Każdy krok przybliża Was do sakramentalnego „tak” 💍"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bom dia! Cada passo te deixa mais perto do 'sim' 💍"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bună dimineața! Fiecare pas te aduce mai aproape de „Da” 💍"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доброе утро! Каждый шаг приближает тебя к заветному «да» 💍"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
