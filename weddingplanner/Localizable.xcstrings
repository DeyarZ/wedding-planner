    "Answer a few questions and we'll build your complete wedding plan — checklist, budget and guest list, all in one place." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجب عن بضعة أسئلة وسنبني خطة زفافك كاملة — قائمة المهام والميزانية وقائمة الضيوف، في مكان واحد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpovězte na pár otázek a my vám sestavíme kompletní svatební plán — seznam úkolů, rozpočet i seznam hostů na jednom místě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
