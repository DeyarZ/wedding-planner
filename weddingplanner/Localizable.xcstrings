    "Bring photos — flowers are easier to show than to describe" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خذ معك صورًا — الزهور يسهل عرضها أكثر من وصفها"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vezměte fotky — květiny se lépe ukazují, než popisují"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag billeder med — blomster er lettere at vise end at beskrive"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bringt Fotos mit — Blumen zeigt man leichter, als man sie beschreibt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llevad fotos: las flores se enseñan mejor de lo que se describen"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Võta fotod kaasa — lilli on lihtsam näidata kui kirjeldada"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota kuvia mukaan — kukkia on helpompi näyttää kuin kuvailla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apportez des photos — les fleurs se montrent mieux qu'elles ne se décrivent"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponesite fotografije — cvijeće je lakše pokazati nego opisati"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vigyél képeket — a virágokat könnyebb megmutatni, mint leírni"
