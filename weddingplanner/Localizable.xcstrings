    "Choose two to four. We'll weight your budget towards them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر اثنين إلى أربعة. سنوجّه ميزانيتك نحوها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte dvě až čtyři. Podle nich upravíme váhy ve vašem rozpočtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg to til fire. Vi vægter jeres budget efter dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählt zwei bis vier. Wir gewichten euer Budget entsprechend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegid entre dos y cuatro. Ajustaremos vuestro presupuesto hacia ellas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vali kaks kuni neli. Suuname sinu eelarve just neile."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse kaksi neljään. Painotamme budjettisi niiden mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez-en deux à quatre. Nous orienterons votre budget vers elles."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite dvije do četiri. Prema njima ćemo usmjeriti vaš proračun."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassz kettőt–négyet. Ezekre súlyozzuk a költségvetésedet."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veldu tvö til fjögur. Við leggjum meiri þunga á þau í fjárhagsáætluninni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sceglietene da due a quattro. Sposteremo il budget in quella direzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2〜4つ選んでください。その分に予算を厚く配分します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 가지에서 네 가지를 골라 주세요. 예산을 그쪽에 더 배분해 드릴게요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvēlies divas līdz četras. Tām atvēlēsim lielāku daļu no tava budžeta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg to til fire. Vi vekter budsjettet deres mot disse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies er twee tot vier. Daar leggen we het zwaartepunt van jullie budget."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierzcie od dwóch do czterech. Na nie przeznaczymy większą część budżetu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolham de duas a quatro. Vamos direcionar o orçamento para elas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege două până la patru. Îți vom orienta bugetul către ele."
