    "Tell us what you'd love to see, or what went wrong. We read every message.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag uns, was du dir wünschst oder was schiefging. Wir lesen jede Nachricht."
          }
        },
