    "Keep your plan for less — one last offer before you go." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ بخطتك بسعر أقل — عرض أخير قبل أن تذهب."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechte si svůj plán levněji — poslední nabídka, než odejdete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behold jeres plan til en lavere pris — et sidste tilbud, før I går."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behaltet euren Plan – für weniger. Ein letztes Angebot, bevor ihr geht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva tu plan por menos: una última oferta antes de irte."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilita oma plaan soodsamalt — üks viimane pakkumine enne lahkumist."
