    "The app is provided 'as is' without any warranties. We shall not be liable for any damages arising from the use of this app. Your use of the app is at your own risk.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wird ohne Gewähr „wie besehen“ bereitgestellt. Wir haften nicht für Schäden aus der Nutzung. Die Nutzung erfolgt auf eigenes Risiko."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se ofrece 'tal cual' sin garantías. No somos responsables de daños por su uso. El uso es bajo tu propio riesgo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app est fournie « telle quelle » sans garantie. Nous ne sommes pas responsables des dommages liés à son usage. L'utilisation se fait à vos risques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app è fornita 'così com'è' senza garanzie. Non siamo responsabili per danni derivanti dall'uso. L'uso è a tuo rischio."
          }
        }
      }
    },
    "The big one": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die große Frage"
          }
        },
        "es": {
